# Copy to .env for local development. Never commit real values.

# E-mail delivery for the idea form and order requests (server route).
# Without SMTP the development server stores submissions in var/innsendinger/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SKJEMA_TIL=
SKJEMA_FRA=

# Card payment through Stripe Checkout (src/server/stripe.ts). Use test keys
# (sk_test_…) until the shop is ready. Card payment also needs «Kortbetaling»
# switched on and at least one shipping option in /admin → Butikk.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks, endpoint https://<site>/api/stripe/webhook/
# with the events checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=
# Public address for Stripe's return links. On Render this is read from RENDER_EXTERNAL_URL.
NETTSTED_URL=

# Set to "true" in production to refuse to start form routes without SMTP.
KREV_EPOST=false
