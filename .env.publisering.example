# Innstillinger for «Publiser Designporten» (docs/publisering-lokalt.md).
# Kopieres til .env.publisering på PC-en din og fylles ut der.
# .env.publisering sendes aldri til GitHub.

# Fra one.com: Kontrollpanel → SSH og SFTP. Verten ser ut som ssh.<kontonavn>.service.one.
ONECOM_SFTP_HOST=
ONECOM_SFTP_BRUKER=
ONECOM_SFTP_PASSORD=
ONECOM_SFTP_PORT=22

# Mappen nettsiden ligger i, sett fra der SFTP starter. «.» betyr startmappen.
ONECOM_ROTMAPPE=.

# Fylles inn automatisk første gang, etter at du har bekreftet serveren.
ONECOM_SFTP_FINGERAVTRYKK=
