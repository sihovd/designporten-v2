{
  "name": "designporten",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Designporten 2.0: showroom og Skaperverksted",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:onecom": "node scripts/bygg-onecom.mjs",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run test:deploy && npm run build",
    "build:onecom:test": "node scripts/bygg-onecom.mjs --test",
    "lint:php": "node scripts/php.mjs --lint",
    "preview:onecom": "node scripts/php.mjs",
    "test:e2e:onecom": "playwright test --config playwright.onecom.config.ts",
    "test:deploy": "node --test scripts/*.test.mjs",
    "pakk:kilde": "node scripts/kildepakke.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/preact": "^6.0.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "astro": "^7.3.5",
    "clipper2-ts": "^2.0.1-18",
    "earcut": "^3.2.4",
    "fflate": "^0.8.3",
    "nodemailer": "^10.0.12",
    "opentype.js": "^2.0.0",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltia/cms": "^0.229.0",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "ssh2": "1.17.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
