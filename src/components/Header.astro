---
/**
 * Site header (preserved behaviour, Sivert 2026-09-02/03):
 * sticky; shrinks, rounds and turns translucent on scroll; mobile shows
 * only the menu button and cart; logo is the way home; a 2 px scroll-progress
 * line in the brand gradient sits at the very top.
 *
 * Added in the visual pass: one marker slides under the navigation to the
 * link being hovered or focused and settles back on the current page; over
 * the graphite workshop surfaces (sections marked `data-mork`, the footer)
 * the header turns graphite too, so the showroom-to-workshop change reaches
 * the chrome.
 */
import Ikon from './Ikon.astro';
import { hovedmeny, erAktiv } from '@/lib/navigasjon';
import { logomerke } from '@/lib/ressurser';

const sti = Astro.url.pathname;
---

<div class="framdrift" aria-hidden="true">
  <i data-framdrift></i>
</div>
<header class="hd" data-header>
  <div class="hd__rad">
    <a class="hd__logo" href="/" aria-label="Designporten, til forsiden">
      <img src={logomerke.src} alt="" width={logomerke.bredde} height={logomerke.hoyde} />
    </a>

    <nav class="hd__nav" aria-label="Hovedmeny">
      <ul data-navliste>
        {hovedmeny.map((p) => (
          <li class:list={[{ 'hd__nav--sti': p.sti }]}>
            <a href={p.href} aria-current={erAktiv(p.href, sti) ? 'page' : undefined}>
              {p.navn}
            </a>
          </li>
        ))}
      </ul>
      <span class="hd__markor" aria-hidden="true" data-markor></span>
    </nav>

    <div class="hd__verktoy">
      <a class="hd__ikon hd__sok" href="/sok/" aria-label="Søk">
        <Ikon navn="sok" />
      </a>
      <a class="hd__ikon hd__kurv" href="/handlekurv/" data-kurvlenke aria-label="Handlekurv, 0 varer">
        <Ikon navn="handlekurv" />
        <span class="hd__antall tall" data-kurvantall hidden>
          0
        </span>
      </a>
      <button
        class="hd__ikon hd__menyknapp"
        type="button"
        aria-expanded="false"
        aria-controls="mobilmeny"
        data-menyknapp
      >
        <Ikon navn="meny" />
        <span class="visuelt-skjult">Meny</span>
      </button>
    </div>
  </div>
</header>

<dialog class="mobilmeny" id="mobilmeny" aria-label="Meny" data-mobilmeny>
  <div class="mobilmeny__topp">
    <span class="mono">Meny</span>
    <button class="hd__ikon" type="button" data-menylukk aria-label="Lukk menyen">
      <Ikon navn="lukk" />
    </button>
  </div>
  <nav aria-label="Hovedmeny, mobil">
    <ul>
      {hovedmeny.map((p) => (
        <li>
          <a href={p.href} aria-current={erAktiv(p.href, sti) ? 'page' : undefined}>
            {p.navn}
          </a>
        </li>
      ))}
      <li>
        <a href="/sok/">Søk</a>
      </li>
    </ul>
  </nav>
</dialog>

<script>
  import { antallVarer, hentKurv, lyttPaKurv } from '@/lib/handel/kurv';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const framdrift = document.querySelector<HTMLElement>('[data-framdrift]');
  const meny = document.querySelector<HTMLDialogElement>('[data-mobilmeny]');
  const menyknapp = document.querySelector<HTMLButtonElement>('[data-menyknapp]');

  let planlagt = false;
  function oppdater() {
    planlagt = false;
    const y = window.scrollY;
    header?.classList.toggle('krympet', y > 24);
    if (framdrift) {
      const maks = document.documentElement.scrollHeight - window.innerHeight;
      framdrift.style.transform = `scaleX(${maks > 0 ? Math.min(1, y / maks) : 0})`;
    }
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!planlagt) {
        planlagt = true;
        requestAnimationFrame(oppdater);
      }
    },
    { passive: true },
  );
  oppdater();

  menyknapp?.addEventListener('click', () => {
    meny?.showModal();
    menyknapp.setAttribute('aria-expanded', 'true');
  });
  meny?.addEventListener('close', () => menyknapp?.setAttribute('aria-expanded', 'false'));
  meny?.querySelector('[data-menylukk]')?.addEventListener('click', () => meny.close());
  meny?.addEventListener('click', (e) => {
    if (e.target === meny) meny.close();
  });

  // Navigation marker: follows hover and focus, rests on the current page.
  const liste = document.querySelector<HTMLElement>('[data-navliste]');
  const markor = document.querySelector<HTMLElement>('[data-markor]');
  if (liste && markor) {
    const lenker = [...liste.querySelectorAll<HTMLAnchorElement>('a')];
    const gjeldende = lenker.find((a) => a.getAttribute('aria-current') === 'page') ?? null;
    const flytt = (a: HTMLAnchorElement | null, synlig = true) => {
      if (!a || !a.offsetParent) {
        markor.style.opacity = '0';
        return;
      }
      const l = a.offsetLeft + 12;
      const b = Math.max(0, a.offsetWidth - 24);
      markor.style.transform = `translateX(${l}px) scaleX(${b / 100})`;
      markor.style.opacity = synlig ? '1' : '0';
    };
    liste.parentElement?.classList.add('hd__nav--markor');
    // Place without a slide first.
    markor.style.transition = 'none';
    flytt(gjeldende, !!gjeldende);
    requestAnimationFrame(() => (markor.style.transition = ''));
    lenker.forEach((a) => {
      a.addEventListener('pointerenter', () => flytt(a));
      a.addEventListener('focus', () => flytt(a));
    });
    const tilbake = () => flytt(gjeldende, !!gjeldende);
    liste.addEventListener('pointerleave', tilbake);
    liste.addEventListener('focusout', (e) => {
      if (!liste.contains(e.relatedTarget as Node)) tilbake();
    });
    window.addEventListener('resize', tilbake);
    document.fonts?.ready.then(tilbake);
  }

  // Graphite header over the workshop surfaces.
  const morke = document.querySelectorAll<HTMLElement>('[data-mork], body > footer');
  if (header && morke.length && 'IntersectionObserver' in window) {
    const over = new Set<Element>();
    const obs = new IntersectionObserver(
      (oppforinger) => {
        for (const o of oppforinger) {
          if (o.isIntersecting) over.add(o.target);
          else over.delete(o.target);
        }
        header.classList.toggle('hd--mork', over.size > 0);
      },
      // A thin band where the header sits.
      { rootMargin: '-20px 0px -94% 0px' },
    );
    morke.forEach((el) => obs.observe(el));
  }

  const antallEl = document.querySelector<HTMLElement>('[data-kurvantall]');
  const kurvLenke = document.querySelector<HTMLElement>('[data-kurvlenke]');
  function visAntall(n: number) {
    if (!antallEl || !kurvLenke) return;
    antallEl.textContent = String(n);
    antallEl.hidden = n === 0;
    kurvLenke.setAttribute('aria-label', `Handlekurv, ${n} ${n === 1 ? 'vare' : 'varer'}`);
  }
  visAntall(antallVarer(hentKurv()));
  lyttPaKurv((l) => visAntall(antallVarer(l)));
</script>

<style>
  .framdrift {
    position: fixed;
    inset: 0 0 auto;
    height: 2px;
    z-index: calc(var(--z-header) + 1);
    pointer-events: none;
  }

  .framdrift i {
    display: block;
    height: 100%;
    background: var(--dp-merkelinje);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /*
   * The header keeps one height in the flow at all times, so nothing below
   * it moves when it changes. At the top it is a full-width bar with the
   * navigation centred between logo and tools. On scroll the bar's surface
   * fades away and the row itself becomes a floating, centred pill: narrower,
   * rounded, a discreet shadow, generous padding inside its ends.
   */
  .hd {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-h);
    background: var(--flate);
    border-bottom: 1px solid var(--kant);
    transition:
      background-color var(--t-trinn) ease,
      border-color var(--t-trinn) ease;
  }

  .hd__rad {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: var(--r-4);
    width: min(var(--innhold-maks), 100% - 2 * var(--gutter));
    height: var(--header-h);
    margin: 0 auto;
    padding-inline: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-pille);
    transition:
      width var(--t-inngang) var(--ease-ut),
      height var(--t-inngang) var(--ease-ut),
      margin var(--t-inngang) var(--ease-ut),
      padding var(--t-inngang) var(--ease-ut),
      background-color var(--t-trinn) ease,
      border-color var(--t-trinn) ease,
      box-shadow var(--t-trinn) ease;
  }

  .hd:global(.krympet) {
    background: transparent;
    border-color: transparent;
  }

  .hd:global(.krympet) .hd__rad {
    width: min(1040px, 100% - 2 * var(--r-4));
    height: var(--header-h-krympet);
    margin-top: calc((var(--header-h) - var(--header-h-krympet)) / 2);
    padding-inline: var(--r-6) var(--r-4);
    border-color: color-mix(in srgb, var(--kant) 80%, transparent);
    background: color-mix(in srgb, var(--flate) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: var(--skygge-meny);
  }

  .hd__logo {
    display: inline-flex;
    align-items: center;
    min-width: var(--mal-beroring);
    min-height: var(--mal-beroring);
    justify-self: start;
  }

  .hd__logo img {
    display: block;
    width: auto;
    height: 38px;
    transition: height var(--t-trinn) var(--ease-ut);
  }

  .hd:global(.krympet) .hd__logo img {
    height: 32px;
  }

  .hd__nav {
    min-width: 0;
  }

  .hd__nav ul {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hd__nav a,
  .mobilmeny a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--mal-beroring);
    padding: 0 var(--r-3);
    color: var(--blekk);
    font-size: 0.9375rem;
    font-weight: 550;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .hd__nav a:hover {
    color: var(--lenke);
  }

  .hd__nav {
    position: relative;
  }

  /* One marker for the whole list, moved with transform only. */
  .hd__markor {
    position: absolute;
    left: 0;
    bottom: 8px;
    width: 100px;
    height: 2px;
    background: var(--dp-lilla);
    transform-origin: 0 50%;
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--t-trinn) var(--ease-ut),
      opacity var(--t-rask) ease;
  }

  .hd__nav--markor a[aria-current='page']::after {
    content: none;
  }

  .hd__nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--r-3);
    right: var(--r-3);
    bottom: 8px;
    height: 2px;
    background: var(--dp-lilla);
  }

  .hd__verktoy {
    display: flex;
    align-items: center;
    gap: var(--r-1);
    justify-self: end;
  }

  .hd__ikon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: var(--mal-beroring);
    height: var(--mal-beroring);
    border: 0;
    border-radius: var(--radius-pille);
    background: transparent;
    color: var(--blekk);
  }

  .hd__ikon:hover {
    background: var(--kalk);
  }

  .hd__antall {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: var(--radius-pille);
    background: var(--dp-lilla);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }

  .hd__menyknapp {
    display: none;
  }

  /* Over the workshop: graphite, light text, cyan focus. */
  .hd:global(.hd--mork) {
    --fokus: var(--dp-cyan);
    background: var(--verksted);
    border-color: var(--linje-mork);
  }

  .hd:global(.hd--mork.krympet) {
    background: transparent;
    border-color: transparent;
  }

  .hd:global(.hd--mork.krympet) .hd__rad {
    background: color-mix(in srgb, var(--grafitt) 82%, transparent);
    border-color: var(--linje-mork);
    box-shadow: 0 14px 34px -18px rgb(0 0 0 / 0.6);
  }

  .hd:global(.hd--mork) :is(.hd__nav a, .hd__ikon) {
    color: var(--tekst-mork);
  }

  .hd:global(.hd--mork) .hd__nav a:hover {
    color: var(--dp-lilla-lys);
  }

  .hd:global(.hd--mork) .hd__ikon:hover {
    background: var(--grafitt-2);
  }

  .hd:global(.hd--mork) .hd__markor {
    background: var(--dp-cyan);
  }

  /* Narrower desktop: secondary items give way first, the three paths stay. */
  @media (max-width: 1180px) {
    .hd__nav li:not(.hd__nav--sti) {
      display: none;
    }

    .hd__menyknapp {
      display: inline-grid;
    }
  }

  /* Mobile: only menu and cart. */
  @media (max-width: 760px) {
    .hd__nav,
    .hd__sok {
      display: none;
    }

    .hd__rad {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .hd:global(.krympet) .hd__rad {
      width: calc(100% - 2 * var(--r-3));
      padding-inline: var(--r-4) var(--r-2);
    }
  }

  .mobilmeny {
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: var(--r-4) var(--gutter) var(--r-6);
    border: 0;
    background: var(--flate);
    color: var(--blekk);
  }

  .mobilmeny::backdrop {
    background: rgb(20 19 23 / 0.4);
  }

  .mobilmeny__topp {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--r-4);
  }

  .mobilmeny ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobilmeny li {
    border-bottom: 1px solid var(--kant);
  }

  .mobilmeny a {
    width: 100%;
    min-height: 56px;
    padding: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
  }

  .mobilmeny a[aria-current='page'] {
    color: var(--lenke);
  }

  @media (prefers-reduced-motion: reduce) {
    .hd,
    .hd__rad,
    .hd__logo img,
    .hd__markor {
      transition: none;
    }
  }
</style>
