---
/**
 * Primary / secondary action. Renders <a> when href is given, else <button>.
 * One primary per view; the secondary never competes at equal strength.
 *
 * Press response: a button is a thin printed layer. On hover it rises by
 * its own thickness and shows the edge; on press it sinks flush. Only
 * transform and box-shadow change, never layout.
 */
interface Props {
  href?: string;
  variant?: 'primar' | 'sekundar' | 'lenke';
  type?: 'button' | 'submit';
  class?: string;
  [attr: string]: unknown;
}

const { href, variant = 'primar', type = 'button', class: klasse, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['knapp', `knapp--${variant}`, klasse]} href={href} type={href ? undefined : type} {...rest}>
  <slot />
</Tag>

<style>
  .knapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--r-2);
    min-height: var(--mal-beroring);
    padding: 0 var(--r-5);
    border-radius: var(--radius-pille);
    border: 1.5px solid transparent;
    font-family: var(--font-tekst);
    font-size: 0.9375rem;
    font-weight: 650;
    font-stretch: 108%;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    --kant-farge: transparent;
    box-shadow: 0 0 0 0 var(--kant-farge);
    transition:
      background-color var(--t-rask) ease,
      border-color var(--t-rask) ease,
      color var(--t-rask) ease,
      transform var(--t-rask) var(--ease-ut),
      box-shadow var(--t-rask) var(--ease-ut);
  }

  .knapp:is(.knapp--primar, .knapp--sekundar):hover {
    transform: translateY(-2px);
    box-shadow: 0 2px 0 0 var(--kant-farge);
  }

  .knapp:is(.knapp--primar, .knapp--sekundar):active {
    transform: translateY(0);
    box-shadow: 0 0 0 0 var(--kant-farge);
    transition-duration: 60ms;
  }

  .knapp--primar {
    --kant-farge: color-mix(in srgb, var(--handling) 55%, #000);
    background: var(--handling);
    color: var(--pa-handling);
  }

  .knapp--primar:hover {
    background: var(--handling-hover);
  }

  .knapp--sekundar {
    --kant-farge: var(--handling);
    background: transparent;
    color: var(--fg);
    border-color: var(--linje-sterk);
  }

  .knapp--sekundar:hover {
    border-color: var(--handling);
    color: var(--lenke);
  }

  .knapp--lenke {
    min-height: auto;
    padding: 0;
    color: var(--lenke);
    text-transform: none;
    letter-spacing: 0;
    font-stretch: 100%;
  }

  .knapp--lenke:hover {
    text-decoration: underline;
  }

  .knapp[aria-disabled='true'],
  .knapp:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .knapp:is(.knapp--primar, .knapp--sekundar):hover {
      transform: none;
    }
  }
</style>
