---
import type { Bilde } from '@/lib/ressurser';

/** An image from the registry. AI concept images carry the «Konseptbilde» tag. */
interface Props {
  bilde: Bilde;
  class?: string;
  lasting?: 'lazy' | 'eager';
  prioritet?: 'high' | 'auto';
  sizes?: string;
  merke?: boolean;
  /**
   * CMS address (e.g. 'sider/forside#helt.bilde') that lets an editor swap the
   * picture on the page; the one.com server then writes the published one in
   * (api/cms/side.php). See docs/cms/README.md#bilder.
   */
  rediger?: string;
}

const {
  bilde,
  class: klasse,
  lasting = 'lazy',
  prioritet = 'auto',
  sizes,
  merke = true,
  rediger,
} = Astro.props;
const cms = rediger ? { 'data-rediger-bilde': rediger, 'data-konsept': bilde.konsept ? '1' : '0' } : {};
---

<span class:list={['konseptbilde', klasse]}>
  <img
    src={bilde.src}
    alt={bilde.alt}
    width={bilde.bredde}
    height={bilde.hoyde}
    loading={lasting}
    decoding="async"
    fetchpriority={prioritet}
    sizes={sizes}
    {...cms}
  />
  {merke && (bilde.konsept || rediger) && (
    <span class="konseptbilde__merke mono" data-konseptmerke={rediger} hidden={!bilde.konsept}>
      Konseptbilde
    </span>
  )}
</span>

<style>
  .konseptbilde {
    position: relative;
    display: block;
  }

  /*
   * Zero-specificity defaults so the caller's own rules for the wrapper or the
   * img always win. The image never stretches: it crops (cover) unless the
   * caller sets another object-fit on the wrapper or the img.
   */
  :global(:where(.konseptbilde)) {
    object-fit: cover;
  }

  :global(:where(.konseptbilde) > img) {
    width: 100%;
    height: 100%;
    object-fit: inherit;
  }

  /* A picture swapped in the CMS carries its focus point (api/cms/side.php). */
  :global(:where(.konseptbilde) > img[data-rediger-bilde]) {
    object-position: var(--fokus, 50% 50%);
  }

  @media (max-width: 720px) {
    :global(:where(.konseptbilde) > img[data-rediger-bilde]) {
      object-position: var(--fokus-mobil, var(--fokus, 50% 50%));
    }
  }

  .konseptbilde__merke[hidden] {
    display: none;
  }

  .konseptbilde__merke {
    position: absolute;
    left: 0;
    top: var(--r-3);
    padding: 3px 8px;
    background: var(--blekk);
    color: #fff;
    font-size: var(--fs-mono-liten);
    font-weight: 500;
    pointer-events: none;
  }
</style>
