---
import { nettsti } from '@/lib/nettsti';
/**
 * «Vårt utvalg»: the product listing (design revision 2026-10-02, §9–10).
 *
 * A short opening, then filters beside the grid. On desktop the filters are a
 * compact column to the left without a heading or a scroll of its own. It
 * stays in view while the products scroll when it fits the window; when it
 * does not, it scrolls with the page (liste.ts decides), so nothing is ever
 * hidden behind an inner scrollbar (Sivert, 2026-10-03).
 * Below 1024 px they move into a sheet opened from a «Filter» button, with the
 * category row above the grid. Sorting sits in the row above the grid at
 * every width.
 *
 * Every card is rendered on every listing page (hidden when filtered out), so
 * changes animate in place. Category links work as plain pages without
 * JavaScript; colour, material and text filters need it and are hidden
 * without it.
 */
import {
  hentProdukter,
  kategorierMedProdukter,
  sorteringsnokler,
  tilgjengeligeSorteringer,
} from '@/lib/handel/katalog';
import { finnKategori, spesialbestillinger } from '@/lib/handel/kategorier';
import { antallTekst, utvalgFor, type Sorteringsgrunnlag } from '@/lib/handel/sortering';
import Ikon from '@/components/Ikon.astro';
import ProduktRutenett from './ProduktRutenett.astro';

interface Props {
  /** 'alle' or a category slug. */
  aktiv: string;
}

const { aktiv } = Astro.props;
const produkter = await hentProdukter();
const nokler = await sorteringsnokler();
const kategorier = kategorierMedProdukter(produkter);
const sorteringer = tilgjengeligeSorteringer(produkter, nokler);

const grunnlag: Sorteringsgrunnlag[] = produkter.map((p) => ({
  id: p.id,
  navn: p.navn,
  kategori: p.kategori,
  prisOre: p.prisOre,
  utvalgt: nokler[p.id]?.utvalgt ?? 0,
  nyeste: nokler[p.id]?.nyeste ?? 0,
  farger: p.farger.map((f) => f.id),
  materialer: p.materialer.map((m) => m.type),
  egenTekst: p.egenTekst !== null,
}));
const synlige = utvalgFor(grunnlag, aktiv, 'utvalgt');
const skjulte = new Set(produkter.filter((p) => !synlige.includes(p.id)).map((p) => p.id));
const rekkefolge = [
  ...synlige.map((id) => produkter.find((p) => p.id === id)!),
  ...produkter.filter((p) => skjulte.has(p.id)),
];

// Filter options come from the catalogue itself: only what some product has.
const fargevalg = [
  ...new Map(produkter.flatMap((p) => p.farger).map((f) => [f.id, f] as const)).values(),
].sort((a, b) => a.navn.localeCompare(b.navn, 'nb'));
const materialvalg = [...new Set(produkter.flatMap((p) => p.materialer.map((m) => m.type)))].sort((a, b) =>
  a.localeCompare(b, 'nb'),
);
const harEgenTekst = produkter.some((p) => p.egenTekst !== null);

const alleTekst = {
  tittel: 'Vårt utvalg',
  ingress: 'Designet og laget av oss. Kanskje finner du akkurat det du leter etter.',
};
const tekster = Object.fromEntries([
  ['alle', { ...alleTekst, href: nettsti('/produkter/') }],
  ...kategorier.map((k) => [
    k.slug,
    { tittel: k.navn, ingress: k.ingress, href: nettsti(`/produkter/kategori/${k.slug}/`) },
  ]),
]);
const aktivTekst =
  aktiv === 'alle'
    ? alleTekst
    : { tittel: finnKategori(aktiv)?.navn ?? '', ingress: finnKategori(aktiv)?.ingress ?? '' };
const harPlassholdere = produkter.some((p) => p.status === 'plassholder');
const data = { grunnlag, tekster };
---

<div class="produktliste" data-produktliste data-aktiv={aktiv}>
  <header class="produktliste__topp ramme">
    <p class="etikett">{aktiv === 'alle' ? 'Produkter' : <a href={nettsti('/produkter/')}>Vårt utvalg</a>}</p>
    <h1 data-liste-tittel>{aktivTekst.tittel}</h1>
    <p class="ingress" data-liste-ingress>
      {aktivTekst.ingress}
    </p>
  </header>

  <div class="produktliste__flate ramme">
    <!-- Mobile and tablet: the category row above the grid. -->
    <div class="produktliste__verktoy">
      <nav class="kategorirad" aria-label="Kategorier">
        <ul>
          <li>
            <a
              href={nettsti('/produkter/')}
              data-kategori="alle"
              aria-current={aktiv === 'alle' ? 'page' : undefined}
            >
              Alle
            </a>
          </li>
          {kategorier.map((k) => (
            <li>
              <a
                href={nettsti(`/produkter/kategori/${k.slug}/`)}
                data-kategori={k.slug}
                aria-current={aktiv === k.slug ? 'page' : undefined}
              >
                {k.navn}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <section class="filter" aria-label="Filtrer og sorter" data-filter>
      <!-- Only shown in the mobile sheet. -->
      <button class="filter__lukk" type="button" data-filter-lukk aria-label="Lukk filteret">
        <Ikon navn="lukk" />
      </button>

      <div class="filter__innhold">
        <fieldset class="filter__gruppe filter__gruppe--kategori">
          <legend>Kategori</legend>
          <ul class="filter__kategorier">
            <li>
              <a
                href={nettsti('/produkter/')}
                data-kategori="alle"
                aria-current={aktiv === 'alle' ? 'page' : undefined}
              >
                Alle produkter
              </a>
            </li>
            {kategorier.map((k) => (
              <li>
                <a
                  href={nettsti(`/produkter/kategori/${k.slug}/`)}
                  data-kategori={k.slug}
                  aria-current={aktiv === k.slug ? 'page' : undefined}
                >
                  {k.navn}
                </a>
              </li>
            ))}
            <li>
              <a class="filter__spesial" href={spesialbestillinger.href}>
                {spesialbestillinger.navn}
                <Ikon navn="pil-hoyre" storrelse={16} />
              </a>
            </li>
          </ul>
        </fieldset>

        <div class="filter__js" data-kun-js>
          {fargevalg.length > 1 && (
            <fieldset class="filter__gruppe">
              <legend>Farge</legend>
              <div class="filter__farger">
                {fargevalg.map((f) => (
                  <label class="fargeprikk" title={f.navn}>
                    <input type="checkbox" name="farge" value={f.id} data-filter-farge />
                    <span class="fargeprikk__prikk" style={`--f: ${f.hex}`} aria-hidden="true"></span>
                    <span class="visuelt-skjult">{f.navn}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          {materialvalg.length > 1 && (
            <fieldset class="filter__gruppe">
              <legend>Materiale</legend>
              <div class="filter__valgliste">
                {materialvalg.map((m) => (
                  <label class="filter__valg">
                    <input type="checkbox" name="materiale" value={m} data-filter-materiale />
                    {m}
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          {harEgenTekst && (
            <fieldset class="filter__gruppe">
              <legend>Tilpasning</legend>
              <label class="filter__valg">
                <input type="checkbox" name="egen-tekst" data-filter-tekst />
                Kan få egen tekst
              </label>
            </fieldset>
          )}

          <div class="filter__bunn">
            <button class="filter__nullstill" type="button" data-filter-nullstill disabled>
              Nullstill
            </button>
            <button class="filter__vis" type="button" data-filter-ferdig>
              Vis <span data-liste-antall-knapp>{antallTekst(synlige.length)}</span>
            </button>
          </div>
        </div>
      </div>
    </section>
    <!-- Below 1024 px the filter panel moves into this sheet while it is open. -->
    <dialog class="filterark" aria-label="Filtrer og sorter" data-filterark></dialog>

    <div class="produktliste__hoved">
      <div class="produktliste__status">
        <div class="produktliste__statusrad">
          <button class="filterknapp" type="button" data-filter-apne data-kun-js aria-haspopup="dialog">
            Filter{' '}
            <span class="filterknapp__antall tall" data-filter-teller hidden>
              0
            </span>
          </button>
          <p class="produktliste__antall" data-liste-antall aria-live="polite">
            {antallTekst(synlige.length)}
          </p>
          <div class="sortering" data-kun-js>
            <label for="produktsortering">Sorter</label>
            <select id="produktsortering" class="sortering__velger" data-liste-sortering>
              {sorteringer.map((s) => (
                <option value={s.verdi}>{s.navn}</option>
              ))}
            </select>
          </div>
        </div>
        {harPlassholdere && (
          <p class="produktliste__notis">
            <strong>Under oppbygging.</strong> Produktene er plassholdere med konseptbilder. Navn, mål og
            priser er ikke fastsatt ennå, men du kan legge dem i handlekurven og sende en uforpliktende
            forespørsel.
          </p>
        )}
      </div>

      <ProduktRutenett
        produkter={rekkefolge}
        skjulte={skjulte}
        nivaa="h2"
        etikett="Produkter"
        class="produktliste__rutenett"
      />
      <p class="produktliste__tom" data-liste-tom hidden>
        Ingen produkter passer filteret.{' '}
        <button type="button" data-filter-nullstill-tom>
          Nullstill filteret
        </button>
      </p>
    </div>
  </div>

  <aside class="produktliste__ide ramme" aria-labelledby="ide-tittel">
    <p class="etikett">Spesialdesign</p>
    <h2 id="ide-tittel">Finner du ikke det du leter etter?</h2>
    <p class="produktliste__ide-tekst">
      Vi lager også ting som ikke står her. Start med ideen, en tegning eller et bilde.
    </p>
    <a class="produktliste__ide-lenke" href={nettsti('/foresporsel/')} data-apne-foresporsel>
      Fortell oss hva du trenger <Ikon navn="pil-hoyre" storrelse={18} />
    </a>
  </aside>
</div>

<script type="application/json" data-produktliste-data set:html={JSON.stringify(data)} />
<script>
  import { startProduktliste } from './liste';
  startProduktliste();
</script>

<style>
  .produktliste {
    padding-block: var(--r-7) var(--r-seksjon);
  }

  .produktliste__topp {
    display: grid;
    gap: var(--r-3);
    margin-bottom: var(--r-7);
  }

  .produktliste__topp .etikett a {
    color: inherit;
  }

  .produktliste__flate {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr);
    gap: var(--r-7);
    align-items: start;
  }

  /* ---------- Desktop: compact filter column ---------- */
  .filter {
    position: static;
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    display: block;
    width: auto;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
  }

  /* Sticky only when the whole column fits the window (set in liste.ts). */
  .filter[data-festet] {
    position: sticky;
    top: calc(var(--header-h) + var(--r-4));
  }

  .filter__lukk {
    display: none;
  }

  .filter__innhold,
  .filter__js {
    display: grid;
    gap: var(--r-3);
  }

  .filter__gruppe {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: var(--r-3) 0 0;
    border: 0;
    border-top: 1px solid var(--kant);
    min-width: 0;
  }

  .filter__gruppe legend,
  .filter__legend {
    float: left;
    width: 100%;
    margin-bottom: 6px;
    padding: 0;
    font-size: var(--fs-mono-liten);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dempet);
  }

  .filter__gruppe--kategori {
    border-top: 0;
    padding-top: 0;
  }

  .filter__kategorier {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    clear: both;
  }

  .filter__kategorier a {
    display: flex;
    align-items: center;
    gap: var(--r-2);
    min-height: 30px;
    padding: 0 var(--r-3);
    margin-inline: calc(-1 * var(--r-3));
    border-radius: var(--radius-skjema);
    color: var(--dempet);
    font-size: var(--fs-liten);
    font-weight: 550;
    text-decoration: none;
    transition:
      background-color var(--t-rask) ease,
      color var(--t-rask) ease;
  }

  .filter__kategorier a:hover {
    background: var(--kalk);
    color: var(--blekk);
  }

  .filter__kategorier a[aria-current='page'] {
    background: var(--flate);
    color: var(--blekk);
    box-shadow: inset 2px 0 0 var(--handling);
  }

  .filter__spesial {
    color: var(--lenke) !important;
  }

  .filter__farger {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .fargeprikk {
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    cursor: pointer;
  }

  .fargeprikk input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .fargeprikk__prikk {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--f);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.18);
    transition: box-shadow var(--t-rask) ease;
  }

  .fargeprikk input:checked + .fargeprikk__prikk {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.18),
      0 0 0 2px var(--papir),
      0 0 0 4px var(--handling);
  }

  .fargeprikk input:focus-visible + .fargeprikk__prikk {
    outline: 2px solid var(--fokus);
    outline-offset: 4px;
  }

  .filter__valgliste {
    clear: both;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--r-3);
  }

  .filter__valg {
    clear: both;
    display: flex;
    align-items: center;
    gap: var(--r-2);
    min-height: 28px;
    font-size: var(--fs-liten);
    cursor: pointer;
  }

  .filter__valg input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--handling);
  }

  .filter__bunn {
    display: flex;
    gap: var(--r-2);
  }

  .filter__nullstill {
    min-height: 28px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--lenke);
    font-size: var(--fs-liten);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .filter__nullstill:disabled {
    color: var(--dempet);
    text-decoration: none;
    cursor: default;
  }

  .filter__vis {
    display: none;
  }

  /* ---------- Grid column ---------- */
  .produktliste__hoved {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .produktliste__status {
    display: grid;
    gap: var(--r-3);
    margin-bottom: var(--r-4);
  }

  .produktliste__statusrad {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--r-2) var(--r-4);
  }

  .produktliste__antall {
    font-size: var(--fs-liten);
    color: var(--dempet);
  }

  .sortering {
    display: flex;
    align-items: center;
    gap: var(--r-2);
    margin-left: auto;
    font-size: var(--fs-liten);
  }

  .sortering label {
    color: var(--dempet);
    font-weight: 600;
  }

  .sortering__velger {
    min-height: 36px;
    padding: 0 var(--r-3);
    border: 1px solid var(--kant-sterk);
    border-radius: var(--radius-skjema);
    background: var(--flate);
    color: var(--blekk);
    font-size: var(--fs-liten);
  }

  .produktliste__notis {
    padding: var(--r-3) var(--r-4);
    border-left: 3px solid var(--advarsel);
    background: var(--flate);
    font-size: var(--fs-liten);
    color: var(--dempet);
  }

  .produktliste__notis strong {
    color: var(--blekk);
  }

  .produktliste__hoved :global(.produktliste__rutenett) {
    width: 100%;
    justify-content: start;
  }

  .produktliste__tom {
    padding: var(--r-6) 0;
    color: var(--dempet);
  }

  .produktliste__tom button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--lenke);
    font-weight: 600;
    text-decoration: underline;
  }

  .produktliste__verktoy,
  .filterknapp {
    display: none;
  }

  :global(html:not(.js)) [data-kun-js] {
    display: none !important;
  }

  /* ---------- Not finding it ---------- */
  .produktliste__ide {
    display: grid;
    justify-items: center;
    gap: var(--r-3);
    margin-top: var(--r-9);
    padding-top: var(--r-7);
    border-top: 1px solid var(--kant);
    text-align: center;
  }

  .produktliste__ide h2 {
    font-size: var(--fs-h2);
  }

  .produktliste__ide-tekst {
    color: var(--dempet);
    max-width: 44ch;
  }

  .produktliste__ide-lenke {
    display: inline-flex;
    align-items: center;
    gap: var(--r-2);
    min-height: var(--mal-beroring);
    font-weight: 600;
  }

  /* ---------- Below 1024 px: filter sheet ---------- */
  @media (max-width: 1023px) {
    .produktliste__flate {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .produktliste__hoved {
      grid-column: 1;
      grid-row: auto;
    }

    .produktliste__verktoy {
      display: grid;
      gap: var(--r-3);
      margin-bottom: var(--r-4);
    }

    .kategorirad {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .kategorirad ul {
      display: flex;
      gap: var(--r-2);
      margin: 0;
      padding: 0;
      list-style: none;
      white-space: nowrap;
    }

    .kategorirad a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 var(--r-4);
      border: 1px solid var(--kant);
      border-radius: var(--radius-pille);
      background: var(--flate);
      color: var(--blekk);
      font-size: var(--fs-liten);
      font-weight: 550;
      text-decoration: none;
    }

    .kategorirad a[aria-current='page'] {
      border-color: var(--blekk);
      background: var(--blekk);
      color: var(--flate);
    }

    .filterknapp {
      display: inline-flex;
      align-items: center;
      gap: var(--r-2);
      min-height: var(--mal-beroring);
      padding: 0 var(--r-4);
      border: 1px solid var(--kant-sterk);
      border-radius: var(--radius-pille);
      background: var(--flate);
      font-size: var(--fs-liten);
      font-weight: 600;
    }

    .filterknapp__antall {
      min-width: 20px;
      height: 20px;
      padding: 0 5px;
      border-radius: var(--radius-pille);
      background: var(--handling);
      color: var(--pa-handling);
      font-size: 0.6875rem;
      line-height: 20px;
    }

    /* The sheet: hidden in the flow when JS runs; a modal from the bottom when open. */
    :global(.js) .produktliste__flate > .filter {
      display: none;
    }

    .filter[data-festet] {
      position: static;
    }

    .filterark {
      position: fixed;
      inset: auto 0 0;
      width: 100%;
      max-width: 100%;
      max-height: min(86dvh, 720px);
      padding: var(--r-3) var(--gutter) 0;
      border-radius: 18px 18px 0 0;
      background: var(--papir);
      box-shadow: 0 -10px 40px -20px rgb(0 0 0 / 0.5);
      overflow-y: auto;
    }

    .filterark::backdrop {
      background: rgb(20 19 23 / 0.36);
      backdrop-filter: blur(3px);
    }

    .filterark .filter__lukk {
      display: grid;
      place-items: center;
      width: var(--mal-beroring);
      height: var(--mal-beroring);
      margin: 0 calc(-1 * var(--r-2)) 0 auto;
      border: 0;
      border-radius: 50%;
      background: none;
    }

    .filterark .filter__js > .filter__gruppe:first-child {
      padding-top: 0;
      border-top: 0;
    }

    /* In the sheet, categories are already in the row above. */
    .filterark .filter__gruppe--kategori {
      display: none;
    }

    .filterark .filter__bunn {
      position: sticky;
      bottom: 0;
      justify-content: space-between;
      align-items: center;
      padding: var(--r-3) 0 max(var(--r-4), env(safe-area-inset-bottom));
      background: var(--papir);
      border-top: 1px solid var(--kant);
    }

    .filterark .filter__vis {
      display: inline-flex;
      align-items: center;
      gap: 0.3em;
      min-height: var(--mal-beroring);
      padding: 0 var(--r-5);
      border: 0;
      border-radius: var(--radius-pille);
      background: var(--handling);
      color: var(--pa-handling);
      font-weight: 600;
    }

    .fargeprikk {
      width: 44px;
      height: 44px;
    }

    .fargeprikk__prikk {
      width: 30px;
      height: 30px;
    }

    .filter__valg {
      min-height: var(--mal-beroring);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @media (max-width: 1023px) {
      .filterark[open] {
        animation: ark-opp 280ms var(--ease-ut);
      }
    }
  }

  @keyframes ark-opp {
    from {
      transform: translateY(100%);
    }
  }
</style>
