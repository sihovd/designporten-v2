---
/**
 * «DU TRENGER IKKE HA EN FERDIG MODELL. START MED IDEEN.» — the idea band:
 * the four ways to start and the way to the idea form. Dark workshop band.
 */
import Knapp from '@/components/Knapp.astro';
import { startpunkter } from './startpunkter';

interface Props {
  /** Heading level. */
  niva?: 2 | 3;
}

const { niva = 2 } = Astro.props;
const Overskrift = `h${niva}` as 'h2' | 'h3';
---

<section class="ideband verksted-flate" aria-labelledby="ideband-tittel">
  <div class="ramme ideband__rutenett">
    <div class="ideband__hode">
      <Overskrift id="ideband-tittel" class="ideband__tittel">
        Du trenger ikke ha en ferdig modell. <span>Start med ideen.</span>
      </Overskrift>
      <Knapp href="/spesialdesign/#skjema">Fortell oss ideen din</Knapp>
    </div>
    <ol class="ideband__veier">
      {startpunkter.map((s, i) => (
        <li class="avslor" style={`--i:${i}`}>
          <a href={`/spesialdesign/?start=${s.id}#skjema`}>
            <span class="mono ideband__nr">{String(i + 1).padStart(2, '0')}</span>
            <span class="ideband__vei">{s.tittel}</span>
            <span class="ideband__tekst">{s.tekst}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ideband {
    padding-block: var(--r-seksjon);
  }

  .ideband__rutenett {
    display: grid;
    gap: var(--r-7);
  }

  .ideband__hode {
    display: grid;
    gap: var(--r-5);
    justify-items: start;
  }

  .ideband__tittel {
    font-size: var(--fs-h1);
    font-stretch: 122%;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    max-width: 18ch;
  }

  .ideband__tittel span {
    color: var(--dp-lilla-lys);
  }

  .ideband__veier {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--linje);
  }

  .ideband__veier li + li {
    border-left: 1px solid var(--linje);
  }

  .ideband__veier a {
    display: grid;
    align-content: start;
    gap: var(--r-2);
    height: 100%;
    padding: var(--r-5) var(--r-4) var(--r-5) 0;
    color: var(--fg);
    text-decoration: none;
  }

  .ideband__veier li + li a {
    padding-left: var(--r-5);
  }

  .ideband__nr {
    color: var(--dp-cyan);
  }

  .ideband__vei {
    font-size: 1.125rem;
    font-weight: 650;
    font-stretch: 108%;
  }

  .ideband__veier a:hover .ideband__vei {
    color: var(--dp-lilla-lys);
    text-decoration: underline;
  }

  .ideband__tekst {
    color: var(--fg-dempet);
    font-size: var(--fs-liten);
  }

  @media (max-width: 900px) {
    .ideband__veier {
      grid-template-columns: 1fr 1fr;
    }

    .ideband__veier li:nth-child(3) {
      border-left: 0;
    }

    .ideband__veier li:nth-child(n + 3) {
      border-top: 1px solid var(--linje);
    }

    .ideband__veier li:nth-child(3) a {
      padding-left: 0;
    }
  }

  @media (max-width: 520px) {
    .ideband__veier {
      grid-template-columns: 1fr;
    }

    .ideband__veier li + li {
      border-left: 0;
      border-top: 1px solid var(--linje);
    }

    .ideband__veier li + li a {
      padding-left: 0;
    }
  }
</style>
