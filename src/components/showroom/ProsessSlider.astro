---
/**
 * Scroll-driven process timeline («Slik blir en idé til et ferdig produkt»).
 * Redesigned in the design revision of 2026-10-02 (§6, §19): the timeline is
 * the main character.
 *
 * - An outer track (`spor`), `takt` of scrolling per step; a sticky scene.
 * - The line fills with scrolling. A step becomes active only when the line
 *   reaches its point (prosess.ts), never before.
 * - Behind it the picture changes like a slideshow (one picture per step,
 *   cross-faded); in front, a framed object evolves from sketch to product.
 * - Text and timeline sit over the scene. Labels are buttons that scroll to
 *   their step. Only normal scrolling drives it; nothing is hijacked.
 * - Reduced motion: no drift, cross-fades become quick fades.
 * - Without JavaScript every step is listed in order under the scene.
 */
import Konseptbilde from '@/components/Konseptbilde.astro';
import VaseBygg, { type Byggtilstand } from '@/components/showroom/bygg/VaseBygg.astro';
import { bakgrunner, type Bilde } from '@/lib/ressurser';

export type Prosessscene =
  /** The vase in one construction state. */
  | { type: 'bygg'; tilstand: Byggtilstand }
  /** One panel (0–3) of the process strip photo, shown as a sheet. */
  | { type: 'ark'; panel: 0 | 1 | 2 | 3 }
  /** No object: the background picture carries the step. */
  | { type: 'ingen' };

export interface Prosesssteg {
  /** Short label on the timeline. */
  kort: string;
  tittel: string;
  tekst: string;
  scene: Prosessscene;
  /** The picture behind this step, and which part of it to show. */
  bakgrunn?: { bilde: Bilde; posisjon?: string };
}

interface Props {
  id: string;
  tittel: string;
  etikett?: string;
  steg: Prosesssteg[];
  /** Scrolling per step, in svh. Lower is faster. */
  takt?: number;
  /** Heading level of the section title. */
  niva?: 2 | 3;
}

const { id, tittel, etikett = 'Prosessen', steg, takt = 55, niva = 2 } = Astro.props;
const n = steg.length;
const to = (i: number) => String(i).padStart(2, '0');
const Overskrift = `h${niva}` as 'h2' | 'h3';
const Stegoverskrift = `h${niva + 1}` as 'h3' | 'h4';
const ark = bakgrunner.prosess.src;
const forste = steg[0]!;
const bakgrunnFor = (s: Prosesssteg): { bilde: Bilde; posisjon?: string } =>
  s.bakgrunn ?? { bilde: bakgrunner.verksted };
const konsept = steg.some((s) => bakgrunnFor(s).bilde.konsept);
const punkt = (i: number) => (n > 1 ? (i / (n - 1)) * 100 : 0);
---

<section
  class="prosess"
  aria-labelledby={`${id}-tittel`}
  data-prosess
  style={`--n: ${n}; --takt: ${takt}svh`}
>
  <div class="ramme prosess__hode avslor">
    <p class="etikett">{etikett}</p>
    <Overskrift id={`${id}-tittel`} class="prosess__tittel">
      {tittel}
    </Overskrift>
  </div>

  <div class="prosess__spor" data-spor>
    <div class="prosess__fest" data-fest>
      <div class="prosess__scene">
        <div class="prosess__bakgrunner" aria-hidden="true" data-drift>
          {steg.map((s, i) => {
            const b = bakgrunnFor(s);
            return (
              <div
                class:list={['prosess__bg', { pa: i === 0 }]}
                data-bg={i}
                style={`--pos: ${b.posisjon ?? '50% 45%'}`}
              >
                <Konseptbilde bilde={b.bilde} class="prosess__bgbilde" merke={false} sizes="100vw" />
              </div>
            );
          })}
        </div>
        <div class="prosess__slor" aria-hidden="true"></div>
        {konsept && <span class="prosess__merke mono">Konseptbilde</span>}

        <div
          class:list={['prosess__ramme', { tom: forste.scene.type === 'ingen' }]}
          aria-hidden="true"
          data-objektramme
        >
          {steg.map((s, i) => (
            <div
              class:list={['prosess__objekt', `prosess__objekt--${s.scene.type}`, { pa: i === 0 }]}
              data-trinn={i}
              data-tom={s.scene.type === 'ingen' ? '' : undefined}
            >
              {s.scene.type === 'bygg' && <VaseBygg tilstand={s.scene.tilstand} merke={false} />}
              {s.scene.type === 'ark' && (
                <div
                  class="prosess__ark"
                  style={`background-image: url(${ark}); --panel: ${s.scene.panel}`}
                />
              )}
            </div>
          ))}
        </div>

        <div class="ramme prosess__overlegg">
          <div class="prosess__under" data-under>
            <p class="mono prosess__nr" data-nr>
              {to(1)} / {to(n)}
            </p>
            <Stegoverskrift class="prosess__stegtittel" data-tittel>
              {forste.tittel}
            </Stegoverskrift>
            <p class="prosess__tekst" data-tekst>
              {forste.tekst}
            </p>
          </div>

          <div class="prosess__tidslinje">
            <div class="prosess__bane" aria-hidden="true">
              <i data-fyll></i>
              {steg.map((_, i) => (
                <span
                  class:list={['prosess__punkt', { naa: i === 0, passert: i === 0 }]}
                  style={`left: ${punkt(i)}%`}
                  data-punkt={i}
                />
              ))}
            </div>
            <ol class="prosess__liste">
              {steg.map((s, i) => (
                <li style={`left: ${punkt(i)}%`}>
                  <button
                    type="button"
                    data-til={i}
                    class:list={{ passert: i === 0 }}
                    aria-current={i === 0 ? 'step' : undefined}
                    aria-label={`Steg ${i + 1} av ${n}: ${s.tittel}`}
                  >
                    <span class="prosess__etikett">{s.kort}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
          <p class="visuelt-skjult" aria-live="polite" data-live></p>
        </div>
      </div>
    </div>
  </div>

  <!-- All steps, used when JavaScript is off. -->
  <ol class="ramme prosess__alle" data-alle>
    {steg.map((s, i) => (
      <li>
        <p class="mono prosess__nr">
          {to(i + 1)} / {to(n)}
        </p>
        <Stegoverskrift class="prosess__stegtittel">{s.tittel}</Stegoverskrift>
        <p class="prosess__tekst">{s.tekst}</p>
      </li>
    ))}
  </ol>

  <script
    is:inline
    type="application/json"
    data-stegdata
    set:html={JSON.stringify(steg.map((s) => ({ tittel: s.tittel, tekst: s.tekst })))}
  />
</section>

<script>
  import { andelForSteg, fyllForAndel, stegForFyll } from './prosess';

  interface Steg {
    tittel: string;
    tekst: string;
  }

  const reduser = window.matchMedia('(prefers-reduced-motion: reduce)');
  const to = (i: number) => String(i).padStart(2, '0');

  function startProsess(rot: HTMLElement) {
    const spor = rot.querySelector<HTMLElement>('[data-spor]')!;
    const fest = rot.querySelector<HTMLElement>('[data-fest]')!;
    const drift = rot.querySelector<HTMLElement>('[data-drift]');
    const fyll = rot.querySelector<HTMLElement>('[data-fyll]');
    const ramme = rot.querySelector<HTMLElement>('[data-objektramme]');
    const under = rot.querySelector<HTMLElement>('[data-under]')!;
    const nr = rot.querySelector<HTMLElement>('[data-nr]')!;
    const tittel = rot.querySelector<HTMLElement>('[data-tittel]')!;
    const tekst = rot.querySelector<HTMLElement>('[data-tekst]')!;
    const live = rot.querySelector<HTMLElement>('[data-live]')!;
    const bakgrunner = [...rot.querySelectorAll<HTMLElement>('[data-bg]')];
    const objekter = [...rot.querySelectorAll<HTMLElement>('[data-trinn]')];
    const punkter = [...rot.querySelectorAll<HTMLElement>('[data-punkt]')];
    const knapper = [...rot.querySelectorAll<HTMLButtonElement>('[data-til]')];
    const data = JSON.parse(rot.querySelector('[data-stegdata]')?.textContent ?? '[]') as Steg[];
    const n = data.length;
    let naa = 0;
    let synlig = false;

    // The scene is sticky from (track top − sticky top) for (track − scene) pixels.
    function festTopp(): number {
      return parseFloat(getComputedStyle(fest).top) || 0;
    }
    function start(): number {
      return spor.getBoundingClientRect().top + window.scrollY - festTopp();
    }
    function lengde(): number {
      return spor.offsetHeight - fest.offsetHeight;
    }

    function settSteg(i: number) {
      if (i === naa) return;
      naa = i;
      bakgrunner.forEach((b, k) => b.classList.toggle('pa', k === i));
      objekter.forEach((o, k) => o.classList.toggle('pa', k === i));
      ramme?.classList.toggle('tom', objekter[i]?.hasAttribute('data-tom') ?? false);
      knapper.forEach((b, j) => {
        if (j === i) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
      });
      const s = data[i]!;
      nr.textContent = `${to(i + 1)} / ${to(n)}`;
      tittel.textContent = s.tittel;
      tekst.textContent = s.tekst;
      live.textContent = `Steg ${i + 1} av ${n}: ${s.tittel}`;
      under.classList.remove('bytt');
      void under.offsetWidth;
      under.classList.add('bytt');
    }

    let planlagt = false;
    function oppdater() {
      planlagt = false;
      const l = lengde();
      if (l <= 0) return;
      const andel = Math.max(0, Math.min(1, (window.scrollY - start()) / l));
      const f = fyllForAndel(andel);
      if (fyll) fyll.style.transform = `scaleX(${f})`;
      // A point lights up only once the line has reached it.
      punkter.forEach((p, i) => {
        const nadd = f >= (n > 1 ? i / (n - 1) : 0) - 1e-4;
        p.classList.toggle('passert', nadd);
        knapper[i]?.classList.toggle('passert', nadd);
      });
      const steg = stegForFyll(f, n);
      punkter.forEach((p, i) => p.classList.toggle('naa', i === steg));
      if (drift)
        drift.style.transform = reduser.matches ? '' : `translate3d(0, ${(-andel * 6).toFixed(2)}%, 0)`;
      settSteg(steg);
    }

    function planlegg() {
      if (!planlagt && synlig) {
        planlagt = true;
        requestAnimationFrame(oppdater);
      }
    }

    new IntersectionObserver(([o]) => {
      synlig = !!o?.isIntersecting;
      if (synlig) planlegg();
    }).observe(spor);
    window.addEventListener('scroll', planlegg, { passive: true });
    window.addEventListener('resize', planlegg);

    // A label scrolls to just after the line has reached its point.
    function tilSteg(i: number) {
      const y = start() + andelForSteg(i, n) * lengde();
      window.scrollTo({ top: Math.ceil(y), behavior: reduser.matches ? 'auto' : 'smooth' });
    }
    knapper.forEach((b) => b.addEventListener('click', () => tilSteg(Number(b.dataset.til))));

    oppdater();
  }

  document.querySelectorAll<HTMLElement>('[data-prosess]').forEach(startProsess);
</script>

<style>
  .prosess {
    --prosess-topp: calc(var(--header-h-krympet) + 22px);
    --scene-h: max(460px, calc(100svh - var(--prosess-topp) - var(--r-4)));
    padding-top: var(--r-8);
  }

  .prosess__hode {
    display: grid;
    gap: var(--r-2);
    margin-bottom: var(--r-5);
  }

  .prosess__tittel {
    max-width: 22ch;
  }

  /* ---------- Track and sticky scene ---------- */
  .prosess__spor {
    position: relative;
  }

  :global(.js) .prosess__spor {
    height: calc(var(--n) * var(--takt) + var(--scene-h));
  }

  :global(.js) .prosess__fest {
    position: sticky;
    top: var(--prosess-topp);
  }

  .prosess__scene {
    position: relative;
    overflow: hidden;
    width: min(100% - 2 * var(--gutter), 1600px);
    height: var(--scene-h);
    margin-inline: auto;
    border-radius: var(--radius-kort);
    background: var(--verksted, #1b1a1f);
    color: #fff;
    isolation: isolate;
  }

  :global(html:not(.js)) .prosess__scene {
    height: min(70svh, 640px);
  }

  /* ---------- Background slideshow ---------- */
  .prosess__bakgrunner {
    position: absolute;
    inset: -6% 0;
    z-index: -3;
    will-change: transform;
  }

  .prosess__bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .prosess__bg.pa,
  .prosess__bg:global(.pa) {
    opacity: 1;
  }

  .prosess__bg :global(.prosess__bgbilde),
  .prosess__bg :global(.prosess__bgbilde img) {
    width: 100%;
    height: 100%;
  }

  .prosess__bg :global(.prosess__bgbilde img) {
    object-fit: cover;
    object-position: var(--pos);
  }

  /* Darkens towards the text and the timeline so white type reads. */
  .prosess__slor {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        0deg,
        rgb(20 19 23 / 0.88) 0%,
        rgb(20 19 23 / 0.62) 30%,
        rgb(20 19 23 / 0.14) 62%,
        rgb(20 19 23 / 0.06) 100%
      ),
      linear-gradient(90deg, rgb(20 19 23 / 0.42) 0%, rgb(20 19 23 / 0) 55%);
  }

  .prosess__merke {
    position: absolute;
    top: var(--r-4);
    left: var(--r-4);
    padding: 3px 8px;
    background: var(--blekk);
    color: #fff;
    font-size: var(--fs-mono-liten);
  }

  /* ---------- The evolving object ---------- */
  .prosess__ramme {
    position: absolute;
    top: 9%;
    right: clamp(var(--r-5), 6vw, 7rem);
    z-index: -1;
    width: min(32%, 400px);
    height: 56%;
    border-radius: var(--radius-kort);
    background: color-mix(in srgb, var(--flate) 94%, transparent);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.6);
    transition:
      opacity 500ms ease,
      transform 500ms var(--ease-ut);
  }

  .prosess__ramme.tom,
  .prosess__ramme:global(.tom) {
    opacity: 0;
    transform: translateY(12px);
  }

  .prosess__objekt {
    position: absolute;
    inset: 6%;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 420ms ease,
      visibility 0s linear 420ms;
  }

  .prosess__objekt.pa,
  .prosess__objekt:global(.pa) {
    opacity: 1;
    visibility: visible;
    transition: opacity 420ms ease;
  }

  .prosess__objekt :global(.bygg) {
    width: auto;
    height: 100%;
    max-width: 100%;
  }

  .prosess__ark {
    height: 100%;
    aspect-ratio: 400 / 533;
    max-width: 100%;
    border-radius: 6px;
    background-size: 400% 100%;
    background-position: calc(var(--panel) * 100% / 3) 0;
  }

  /* ---------- Text and timeline over the scene ---------- */
  .prosess__overlegg {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: var(--r-5);
    padding-bottom: var(--r-6);
  }

  .prosess__under {
    display: grid;
    gap: var(--r-2);
    max-width: 30rem;
  }

  .prosess__nr {
    color: rgb(255 255 255 / 0.78);
  }

  .prosess__stegtittel {
    color: #fff;
    font-size: var(--fs-h2);
    font-weight: var(--vekt-overskrift);
  }

  .prosess__tekst {
    min-height: 3.2em;
    color: rgb(255 255 255 / 0.88);
  }

  @media (prefers-reduced-motion: no-preference) {
    .prosess__under:global(.bytt) :is(.prosess__stegtittel, .prosess__tekst) {
      animation: prosess-tekst 320ms var(--ease-ut);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prosess__bg,
    .prosess__objekt,
    .prosess__objekt.pa,
    .prosess__ramme {
      transition-duration: 120ms;
    }
  }

  @keyframes prosess-tekst {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .prosess__tidslinje {
    position: relative;
    padding-bottom: 2.25rem;
  }

  .prosess__bane {
    position: relative;
    height: 2px;
    background: rgb(255 255 255 / 0.28);
  }

  .prosess__bane > i {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .prosess__punkt {
    position: absolute;
    top: 50%;
    width: 11px;
    height: 11px;
    border: 2px solid rgb(255 255 255 / 0.55);
    border-radius: 50%;
    background: rgb(20 19 23 / 0.8);
    transform: translate(-50%, -50%);
    transition:
      background-color var(--t-rask) ease,
      border-color var(--t-rask) ease,
      box-shadow var(--t-trinn) ease;
  }

  .prosess__punkt:global(.passert) {
    border-color: #fff;
    background: #fff;
  }

  .prosess__punkt:global(.naa) {
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--dp-lilla) 70%, transparent);
  }

  .prosess__liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prosess__liste li {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
  }

  .prosess__liste li:first-child {
    transform: none;
  }

  .prosess__liste li:last-child {
    transform: translateX(-100%);
  }

  .prosess__liste button {
    min-height: var(--mal-min);
    padding: 10px 2px 4px;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.72);
    font: inherit;
    font-size: var(--fs-liten, 0.8125rem);
    white-space: nowrap;
    transition: color var(--t-rask) ease;
  }

  .prosess__liste button:global(.passert) {
    color: #fff;
  }

  .prosess__liste button[aria-current='step'] {
    color: #fff;
    font-weight: 650;
  }

  .prosess__liste button:hover .prosess__etikett {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prosess__liste button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* ---------- Tablet and phone ---------- */
  @media (max-width: 760px) {
    .prosess__scene {
      width: 100%;
      border-radius: 0;
    }

    .prosess__ramme {
      top: var(--r-6);
      right: 50%;
      width: min(58%, 260px);
      height: 40%;
      transform: translateX(50%);
    }

    .prosess__ramme.tom,
    .prosess__ramme:global(.tom) {
      transform: translate(50%, 12px);
    }

    .prosess__slor {
      background: linear-gradient(
        0deg,
        rgb(20 19 23 / 0.92) 0%,
        rgb(20 19 23 / 0.7) 38%,
        rgb(20 19 23 / 0.2) 62%,
        rgb(20 19 23 / 0.1) 100%
      );
    }

    .prosess__stegtittel {
      font-size: var(--fs-h3);
    }

    .prosess__tidslinje {
      padding-bottom: 0;
    }

    /* Phones: the dots are the targets; labels stay for screen readers. */
    .prosess__liste li,
    .prosess__liste li:first-child,
    .prosess__liste li:last-child {
      top: 50%;
      transform: translate(-50%, -50%);
    }

    .prosess__liste button {
      width: 32px;
      min-height: 32px;
      padding: 0;
    }

    .prosess__etikett {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* ---------- Without JavaScript: all steps in order ---------- */
  .prosess__alle {
    display: grid;
    gap: var(--r-5);
    margin-top: var(--r-6);
    padding: 0;
    list-style: none;
  }

  .prosess__alle li {
    display: grid;
    gap: var(--r-2);
    max-width: 52ch;
  }

  .prosess__alle .prosess__nr {
    color: var(--dempet);
  }

  .prosess__alle .prosess__stegtittel {
    color: var(--blekk);
    font-size: var(--fs-h3);
  }

  .prosess__alle .prosess__tekst {
    min-height: 0;
    color: var(--dempet);
  }

  :global(.js) .prosess__alle {
    display: none;
  }

  :global(html:not(.js)) .prosess__overlegg,
  :global(html:not(.js)) .prosess__ramme {
    display: none;
  }
</style>
