---
/**
 * Top slider (preserved component, test bench 2026-09-03/04;
 * interaction-and-motion.md#top-slider). A sequence of scenes for highlights,
 * not the homepage hero.
 *
 * - Control row on top, with a hairline under it: category eyebrow (left),
 *   dots, counter «1 / 3», Forrige / Neste, and a pause control.
 * - Full-width scene; text directly under the image (14 px), centred.
 * - Autoplay every 6 s, paused on hover, focus and interaction, with a
 *   visible pause control (WCAG 2.2.2); off under reduced motion.
 * - Without JavaScript all slides are shown in order.
 */
import Knapp from '@/components/Knapp.astro';
import type { Bilde } from '@/lib/ressurser';

export interface Lysbilde {
  kategori: string;
  tittel: string;
  tekst: string;
  bakgrunn: Bilde;
  objekt?: Bilde;
  handlinger: { tekst: string; href: string; variant?: 'primar' | 'sekundar' }[];
}

interface Props {
  id: string;
  /** Accessible name of the carousel. */
  etikett: string;
  lysbilder: Lysbilde[];
}

const { id, etikett, lysbilder } = Astro.props;
const n = lysbilder.length;
---

<section class="topp" aria-roledescription="karusell" aria-label={etikett} data-toppslider id={id}>
  <div class="ramme">
    <div class="topp__kontroller">
      <p class="mono topp__kategori" data-kategori>
        {lysbilder[0]?.kategori}
      </p>
      <div class="topp__prikker">
        {lysbilder.map((l, i) => (
          <button
            class="topp__prikk"
            type="button"
            data-til={i}
            aria-label={`Vis lysbilde ${i + 1}: ${l.tittel}`}
            aria-current={i === 0 ? 'true' : undefined}
          />
        ))}
      </div>
      <span class="mono topp__teller" data-teller aria-hidden="true">
        1 / {n}
      </span>
      <button class="topp__knapp" type="button" data-forrige>
        Forrige
      </button>
      <button class="topp__knapp" type="button" data-neste>
        Neste
      </button>
      <button class="topp__knapp topp__pause" type="button" data-pause aria-pressed="false">
        Pause
      </button>
    </div>
  </div>

  <div class="topp__lysbilder" aria-live="off" data-lysbilder>
    {lysbilder.map((l, i) => (
      <div
        class:list={['topp__lysbilde', { pa: i === 0 }]}
        role="group"
        aria-roledescription="lysbilde"
        aria-label={`${i + 1} av ${n}`}
        data-lysbilde={i}
      >
        <div class="topp__scene">
          <div class="topp__bg" style={`background-image: url(${l.bakgrunn.src})`} />
          {(l.bakgrunn.konsept || l.objekt?.konsept) && <span class="topp__merke mono">Konseptbilde</span>}
          {l.objekt && (
            <img
              class="topp__objekt"
              src={l.objekt.src}
              alt={l.objekt.alt}
              width={l.objekt.bredde}
              height={l.objekt.hoyde}
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
        <div class="ramme">
          <div class="topp__tekst">
            <p class="mono topp__kategori-tekst">{l.kategori}</p>
            <h3>{l.tittel}</h3>
            <p class="topp__ingress">{l.tekst}</p>
            <div class="topp__handlinger">
              {l.handlinger.map((h) => (
                <Knapp href={h.href} variant={h.variant ?? 'primar'}>
                  {h.tekst}
                </Knapp>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const reduser = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-toppslider]').forEach((rot) => {
    const bilder = [...rot.querySelectorAll<HTMLElement>('[data-lysbilde]')];
    const prikker = [...rot.querySelectorAll<HTMLButtonElement>('[data-til]')];
    const kategori = rot.querySelector<HTMLElement>('[data-kategori]')!;
    const teller = rot.querySelector<HTMLElement>('[data-teller]')!;
    const pause = rot.querySelector<HTMLButtonElement>('[data-pause]')!;
    const region = rot.querySelector<HTMLElement>('[data-lysbilder]')!;
    const kategorier = bilder.map((b) => b.querySelector('.topp__kategori-tekst')?.textContent ?? '');
    let indeks = 0;
    let ur: number | undefined;
    let pauset = reduser.matches;
    let holder = false; // hover or focus inside

    function vis(i: number) {
      indeks = (i + bilder.length) % bilder.length;
      bilder.forEach((b, k) => {
        b.classList.toggle('pa', k === indeks);
        b.inert = k !== indeks;
      });
      prikker.forEach((p, k) => {
        if (k === indeks) p.setAttribute('aria-current', 'true');
        else p.removeAttribute('aria-current');
      });
      teller.textContent = `${indeks + 1} / ${bilder.length}`;
      kategori.textContent = kategorier[indeks] ?? '';
    }

    function stopp() {
      window.clearInterval(ur);
      ur = undefined;
    }

    function start() {
      stopp();
      if (pauset || holder || bilder.length < 2) return;
      ur = window.setInterval(() => vis(indeks + 1), 6000);
    }

    function settPause(p: boolean) {
      pauset = p;
      pause.setAttribute('aria-pressed', String(p));
      pause.textContent = p ? 'Spill av' : 'Pause';
      region.setAttribute('aria-live', p ? 'polite' : 'off');
      start();
    }

    // Manual navigation counts as interaction: autoplay stops.
    function manuelt(i: number) {
      vis(i);
      settPause(true);
    }

    rot.querySelector('[data-forrige]')?.addEventListener('click', () => manuelt(indeks - 1));
    rot.querySelector('[data-neste]')?.addEventListener('click', () => manuelt(indeks + 1));
    prikker.forEach((p) => p.addEventListener('click', () => manuelt(Number(p.dataset.til))));
    pause.addEventListener('click', () => settPause(!pauset));

    rot.addEventListener('pointerenter', () => {
      holder = true;
      stopp();
    });
    rot.addEventListener('pointerleave', () => {
      holder = false;
      start();
    });
    rot.addEventListener('focusin', () => {
      holder = true;
      stopp();
    });
    rot.addEventListener('focusout', (e) => {
      if (!rot.contains(e.relatedTarget as Node | null)) {
        holder = false;
        start();
      }
    });

    // Only run while on screen.
    new IntersectionObserver(([o]) => {
      if (o?.isIntersecting) start();
      else stopp();
    }).observe(rot);

    rot.classList.add('topp--aktiv');
    vis(0);
    settPause(pauset);
  });
</script>

<style>
  .topp {
    padding-top: var(--r-seksjon);
  }

  .topp__kontroller {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--kant);
  }

  .topp__kategori {
    margin: 0 auto 0 0;
    color: var(--dempet);
  }

  .topp__prikker {
    display: flex;
  }

  /* The button is the 24 px target (WCAG 2.2); the 9 px dot is drawn inside it. */
  .topp__prikk {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    transition: width 220ms ease;
  }

  .topp__prikk::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: var(--radius-pille);
    background: var(--kant-sterk);
    transition:
      width 220ms ease,
      background-color 220ms ease;
  }

  .topp__prikk[aria-current='true'] {
    width: 36px;
  }

  .topp__prikk[aria-current='true']::before {
    width: 26px;
    background: var(--dp-lilla);
  }

  .topp__teller {
    color: var(--dempet);
    margin-left: 2px;
  }

  .topp__knapp {
    min-height: 36px;
    padding: 0 15px;
    border: 1px solid var(--kant-sterk);
    border-radius: var(--radius-pille);
    background: transparent;
    font-size: 0.8125rem;
    font-weight: 520;
  }

  .topp__knapp:hover {
    border-color: var(--lenke);
    color: var(--lenke);
  }

  .topp__scene {
    position: relative;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    max-height: 70svh;
    width: 100%;
    background: var(--kalk);
  }

  .topp__bg {
    position: absolute;
    inset: -14% 0;
    background-size: cover;
    background-position: 50% 40%;
  }

  .topp__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      58% 68% at 50% 54%,
      rgb(255 255 255 / 0.8) 0%,
      rgb(255 255 255 / 0.34) 58%,
      rgb(255 255 255 / 0) 82%
    );
  }

  .topp__merke {
    position: absolute;
    left: 0;
    top: var(--r-3);
    z-index: 3;
    padding: 3px 8px;
    background: var(--blekk);
    color: #fff;
    font-size: var(--fs-mono-liten);
  }

  .topp__objekt {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 34%;
    height: 74%;
    object-fit: contain;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 26px 34px rgb(0 0 0 / 0.28));
  }

  .topp__tekst {
    display: grid;
    gap: 12px;
    justify-items: center;
    max-width: 56ch;
    margin-inline: auto;
    padding-top: 14px;
    text-align: center;
  }

  .topp__kategori-tekst {
    color: var(--dempet);
    margin-bottom: -2px;
  }

  .topp__tekst h3 {
    font-size: var(--fs-h2);
    font-stretch: 112%;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.07;
  }

  .topp__ingress {
    color: var(--dempet);
    font-size: 1.0625rem;
  }

  .topp__handlinger {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--r-3);
    margin-top: 4px;
  }

  /* With JavaScript: one slide at a time. Without: all, stacked. */
  .topp__lysbilder {
    display: grid;
    gap: var(--r-8);
  }

  :global(html:not(.js)) .topp__kontroller > :not(.topp__kategori) {
    display: none;
  }

  :global(.js) .topp__lysbilde:not(.pa) {
    display: none;
  }

  :global(.js) .topp__kategori-tekst {
    /* The eyebrow in the control row carries the category. */
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .topp__lysbilde.pa .topp__tekst {
      animation: topp-tekst 440ms var(--ease-ut);
    }

    :global(.js) .topp__lysbilde.pa .topp__objekt {
      animation: topp-objekt 420ms var(--ease-ut);
    }
  }

  @keyframes topp-tekst {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes topp-objekt {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) translateX(30px);
    }
  }

  @media (max-width: 600px) {
    .topp__scene {
      aspect-ratio: 4 / 3;
    }

    .topp__objekt {
      width: 52%;
    }

    .topp__kategori {
      flex-basis: 100%;
    }
  }
</style>
