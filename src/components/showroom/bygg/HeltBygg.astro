---
/**
 * The hero's build field (interaction-and-motion.md#homepage-hero): one
 * object in one continuous field, split by the print line. Above the line
 * the vase is still a digital model (contour, cross-sections, twisted ribs);
 * below it the printed object. The line rises as the build advances, so
 * the first frame already shows both worlds: idea and physical object.
 *
 * Driven entirely by custom properties set by the hero script:
 *   --q   print height 0–1 (0 = nothing printed, 1 = finished)
 *   --mx  pointer offset −1…1 (parallax between drawing and object)
 * Stage classes on the hero (`na-1` … `na-5`) draw the construction in.
 *
 * All geometry is the vase's own (vasegeometri.ts, functional geometry, D-3).
 * Construction lines run past the object to the edges of the viewport.
 */
import Konseptbilde from '@/components/Konseptbilde.astro';
import { utklippbilder } from '@/lib/ressurser';
import {
  AKSE_X,
  BUNN_Y,
  TOPP_Y,
  VISNING,
  frontbue,
  kontur,
  lag,
  ribber,
  silhuett,
  snitt,
  snittliste,
} from './vasegeometri';

interface Props {
  class?: string;
}

const { class: klasse } = Astro.props;

const k = kontur();
const snittene = snittliste(7);
const ribbene = ribber(14, 2.3).join(' ');
const lagene = lag(46);
const bunn = snitt(BUNN_Y);
const topp = snitt(TOPP_Y);
const midt = snitt(470);
const bilde = utklippbilder.spiralvase;
// Far enough past the object to reach the viewport edges on wide screens.
const LANGT = 4200;
---

<div
  class:list={['hb', klasse]}
  style={`--silhuett: ${silhuett()}; --topp: ${TOPP_Y}; --bunn: ${BUNN_Y}`}
  aria-hidden="true"
>
  <svg class="hb__linjer" viewBox={`0 0 ${VISNING} ${VISNING}`} preserveAspectRatio="xMidYMid meet">
    <line class="hb__akse" x1={AKSE_X} y1={-VISNING} x2={AKSE_X} y2={BUNN_Y + 60} pathLength="1" />
    {[topp, midt, bunn].map((e) => (
      <line x1={-LANGT} y1={e.cy} x2={VISNING + LANGT} y2={e.cy} pathLength="1" />
    ))}
  </svg>

  <span class="hb__skygge"></span>
  <Konseptbilde bilde={bilde} class="hb__objekt" lasting="eager" prioritet="high" merke={false} />

  <svg class="hb__tegning" viewBox={`0 0 ${VISNING} ${VISNING}`} preserveAspectRatio="xMidYMid meet">
    <defs>
      <clipPath id="hb-over">
        <rect
          class="hb__klipp"
          x={-LANGT}
          y={-VISNING * 2}
          width={VISNING + 2 * LANGT}
          height={VISNING * 2}
        />
      </clipPath>
      <clipPath id="hb-varm">
        <rect class="hb__klipp" x={-LANGT} y="0" width={VISNING + 2 * LANGT} height="34" />
      </clipPath>
    </defs>

    <g class="hb__kontur">
      <path d={k.venstre} pathLength="1" />
      <path d={k.hoyre} pathLength="1" />
      <ellipse cx={topp.cx} cy={topp.cy} rx={topp.rx} ry={topp.ry} pathLength="1" />
      <path d={frontbue(bunn)} pathLength="1" />
    </g>

    <g clip-path="url(#hb-over)">
      <g class="hb__geometri">
        {snittene.map((e) => (
          <ellipse cx={e.cx} cy={e.cy} rx={e.rx} ry={e.ry} pathLength="1" />
        ))}
      </g>
      <g class="hb__mesh">
        <path d={ribbene} pathLength="1" data-ribber />
      </g>
    </g>

    <g class="hb__lag" clip-path="url(#hb-varm)">
      {lagene.map((d) => (
        <path d={d} />
      ))}
    </g>

    <g class="hb__dyse">
      <line x1={-LANGT} y1="0" x2={VISNING + LANGT} y2="0" class="hb__bane" />
      <line x1={AKSE_X - 250} y1="0" x2={AKSE_X + 250} y2="0" class="hb__spor" />
    </g>
  </svg>
</div>

<style>
  .hb {
    /* Print line height in the drawing's own units (0–900, y down). */
    --yq: calc(var(--bunn) - (var(--bunn) - var(--topp)) * var(--q, 1));
    position: relative;
    aspect-ratio: 1;
    width: 100%;
  }

  .hb__linjer,
  .hb__tegning {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .hb__linjer *,
  .hb__tegning * {
    vector-effect: non-scaling-stroke;
  }

  /* Construction lines: axis and the rim, belly and base levels. */
  .hb__linjer {
    stroke: var(--kant-sterk);
    stroke-width: 1;
    stroke-dasharray: 0.0015 0.0012;
    opacity: 0.55;
  }

  .hb__akse {
    stroke-dasharray: 0.006 0.004;
  }

  .hb > :global(.hb__objekt) {
    position: absolute;
    inset: 0;
    clip-path: inset(calc(var(--yq) / 9 * 1%) 0 0 0);
    transform: translateX(calc(var(--mx, 0) * -4px));
  }

  /* Cut to the vase itself (the concept cut-out carries a baked-in shadow). */
  .hb :global(.hb__objekt img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    clip-path: var(--silhuett);
  }

  .hb__skygge {
    position: absolute;
    left: 20%;
    width: 42%;
    top: 85%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(24 23 28 / 0.28), rgb(24 23 28 / 0));
    opacity: min(1, calc(var(--q) * 4));
  }

  .hb__tegning {
    transform: translateX(calc(var(--mx, 0) * 8px));
  }

  .hb__kontur {
    stroke: var(--blekk);
    stroke-width: 2;
  }

  .hb__geometri {
    stroke: var(--dp-cyan-tekst);
    stroke-width: 1;
  }

  .hb__mesh {
    stroke: var(--dp-lilla);
    stroke-width: 1.2;
  }

  /* Freshly printed layers just below the nozzle. */
  .hb__lag {
    stroke: var(--dp-lilla);
    stroke-width: 2.4;
    opacity: 0.85;
  }

  .hb__klipp {
    transform: translateY(calc(var(--yq) * 1px));
  }

  .hb__dyse {
    transform: translateY(calc(var(--yq) * 1px));
  }

  .hb__bane {
    stroke: var(--dp-lilla);
    stroke-width: 1;
    opacity: 0.45;
  }

  .hb__spor {
    stroke: var(--dp-lilla);
    stroke-width: 2.5;
  }

  /*
   * ---------- States ----------
   * Without the hero script (no JS, or before it runs) the field shows the
   * finished object only. The script adds `.bygging` to an ancestor and
   * then the stage classes `.na-0` … `.na-5` as the build advances.
   */
  .hb__tegning,
  .hb__linjer {
    opacity: 0;
    transition: opacity var(--t-inngang) var(--ease-ut);
  }

  :global(.bygging) .hb__linjer {
    opacity: 0;
  }

  :global(.bygging.na-0) .hb__linjer {
    opacity: 0.55;
  }

  :global(.bygging) .hb__tegning {
    opacity: 1;
  }

  :global(.bygging) :is(.hb__kontur, .hb__geometri, .hb__mesh) > * {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 560ms var(--ease-ut);
  }

  :global(.bygging.na-1) .hb__kontur > *,
  :global(.bygging.na-2) .hb__geometri > *,
  :global(.bygging.na-3) .hb__mesh > * {
    stroke-dashoffset: 0;
  }

  :global(.bygging) :is(.hb__dyse, .hb__lag) {
    opacity: 0;
    transition: opacity var(--t-trinn) var(--ease-ut);
  }

  :global(.bygging.na-4) .hb__dyse {
    opacity: 1;
  }

  :global(.bygging.na-4) .hb__lag {
    opacity: 0.85;
  }

  /* Finished: the model gives way to the object, the construction stays faint. */
  :global(.bygging.na-5) .hb__tegning {
    opacity: 0;
  }

  :global(.bygging.na-5) .hb__linjer {
    opacity: 0.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .hb *,
    :global(.bygging) .hb * {
      transition: none !important;
    }

    .hb > :global(.hb__objekt),
    .hb__tegning {
      transform: none;
    }
  }
</style>
