---
/**
 * Homepage hero (interaction-and-motion.md#homepage-hero).
 * «VI GIR IDEER FORM» is the composition: the vase is built in front of the
 * visitor (skisse → kontur → geometri → mesh → lag → printet objekt) and
 * stands on the word FORM, which is itself printed layer by layer.
 * The actions are visible and usable from the first frame.
 */
import Knapp from '@/components/Knapp.astro';
import VaseBygg from '@/components/showroom/bygg/VaseBygg.astro';

const tilstander = ['Skisse', 'Kontur', 'Geometri', 'Mesh', 'Lag', 'Objekt'];
---

<section class="helt" aria-labelledby="helt-tittel" data-helt>
  <div class="ramme helt__rutenett">
    <p class="helt__eyebrow mono">Designporten · 3D-print og spesialdesign</p>

    <h1 class="helt__tittel" id="helt-tittel">
      <span class="helt__linje1">Vi gir ideer</span>
      <span class="helt__form">
        form
        <span class="helt__print" aria-hidden="true">
          form
        </span>
      </span>
    </h1>

    <div class="helt__scene">
      <VaseBygg animert lasting="eager" class="helt__vase" />
      <div class="helt__avlesning" aria-hidden="true">
        <ol class="mono">
          {tilstander.map((t, i) => (
            <li style={`--i:${i}`}>
              <span class="tall">{String(i + 1).padStart(2, '0')}</span> {t}
            </li>
          ))}
        </ol>
      </div>
      <button class="helt__igjen mono" type="button" data-bygg-igjen>
        Bygg på nytt
      </button>
    </div>

    <div class="helt__tekst">
      <p class="helt__statement">Fra tanke til noe du kan berøre</p>
      <p class="helt__ingress">
        Vi tegner og printer ting som passer, holder og ser ut som noe du vil ha stående framme. Finn noe
        ferdig, lag noe selv, eller fortell oss ideen din.
      </p>
      <div class="helt__handlinger">
        <Knapp href="/skaperverksted/">Start å skape</Knapp>
        <Knapp href="/spesialdesign/#skjema" variant="sekundar">
          Fortell oss ideen din
        </Knapp>
      </div>
    </div>
  </div>
</section>

<script>
  // Replays the build sequence on request. It never replays on its own.
  document.querySelectorAll<HTMLElement>('[data-helt]').forEach((helt) => {
    helt.querySelector('[data-bygg-igjen]')?.addEventListener('click', () => {
      helt.classList.remove('helt--spiller');
      const animerte = helt.querySelectorAll<HTMLElement>('.bygg--animert, .helt__print, .helt__avlesning');
      animerte.forEach((el) => {
        el.getAnimations({ subtree: true }).forEach((a) => {
          a.cancel();
          a.play();
        });
      });
    });
  });
</script>

<style>
  .helt {
    position: relative;
    overflow: hidden;
    padding-block: var(--r-6) var(--r-7);
  }

  .helt__rutenett {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 34%) 1fr;
    grid-template-rows: auto auto auto;
    column-gap: var(--r-5);
    align-items: end;
  }

  .helt__eyebrow {
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: start;
    color: var(--dempet);
    margin-bottom: var(--r-5);
  }

  /* The heading spans the composition; its lines sit in the parent's cells. */
  .helt__tittel {
    grid-column: 1 / -1;
    grid-row: 2 / 4;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    font-size: var(--fs-display);
    font-stretch: 125%;
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .helt__linje1 {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    max-width: 6.2ch;
    padding-bottom: var(--r-4);
  }

  .helt__form {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
    /* Fills the content width: FORM is about 3.7 em wide at this setting. */
    font-size: min(calc((100vw - 2 * var(--gutter)) / 3.75), 21rem);
    line-height: 0.78;
    letter-spacing: -0.045em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--kant-sterk);
    padding-top: 0.04em;
  }

  /* FORM set on layer lines: printed bottom-up, one layer at a time. */
  .helt__print {
    position: absolute;
    inset: 0;
    padding-top: inherit;
    -webkit-text-stroke: 0;
    background: repeating-linear-gradient(
      180deg,
      var(--blekk) 0 0.034em,
      color-mix(in srgb, var(--blekk) 72%, var(--papir)) 0.034em 0.045em
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .helt__scene {
    position: relative;
    grid-column: 2;
    grid-row: 2;
    z-index: 1;
    align-self: end;
    margin-bottom: -12%;
  }

  .helt__tekst {
    grid-column: 3;
    grid-row: 2;
    display: grid;
    gap: var(--r-4);
    align-self: end;
    padding-bottom: var(--r-5);
  }

  .helt__statement {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-stretch: 118%;
    font-weight: 720;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    max-width: 16ch;
  }

  .helt__ingress {
    color: var(--dempet);
    max-width: 38ch;
  }

  .helt__handlinger {
    display: flex;
    flex-wrap: wrap;
    gap: var(--r-3);
    margin-top: var(--r-2);
  }

  /* The readout and replay sit in the empty right third of the picture. */
  .helt__avlesning {
    position: absolute;
    top: 8%;
    right: 0;
  }

  .helt__avlesning ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-mono-liten);
    color: var(--dempet);
  }

  .helt__avlesning li:last-child {
    color: var(--blekk);
  }

  .helt__avlesning .tall {
    color: inherit;
    margin-right: 4px;
  }

  .helt__igjen {
    position: absolute;
    right: 0;
    bottom: 22%;
    min-height: var(--mal-min);
    padding: 4px 10px;
    border: 1px solid var(--kant);
    border-radius: var(--radius-pille);
    background: var(--flate);
    color: var(--dempet);
    font-size: var(--fs-mono-liten);
  }

  .helt__igjen:hover {
    color: var(--lenke);
    border-color: var(--lenke);
  }

  .helt__igjen {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .helt__igjen {
      display: inline-flex;
      align-items: center;
    }

    :global(.js) .helt__print {
      clip-path: inset(100% 0 0 0);
      animation: helt-print 900ms steps(18, end) 1500ms forwards;
    }

    :global(.js) .helt__avlesning li {
      animation: helt-les 420ms linear both;
      animation-delay: calc(150ms + var(--i) * 380ms);
    }

    :global(.js) .helt__avlesning li:last-child {
      animation-name: helt-les-siste;
    }
  }

  @keyframes helt-print {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes helt-les {
    0%,
    100% {
      color: var(--dempet);
    }

    10%,
    90% {
      color: var(--lenke);
    }
  }

  @keyframes helt-les-siste {
    0% {
      color: var(--dempet);
    }

    100% {
      color: var(--blekk);
    }
  }

  /* ---------- Narrower screens: one column, the vase between the lines ---------- */
  @media (max-width: 1023px) {
    .helt__rutenett {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto auto;
    }

    .helt__tittel {
      grid-row: 2 / 5;
      grid-template-rows: subgrid;
    }

    .helt__linje1 {
      grid-row: 1;
      max-width: none;
      padding-bottom: 0;
    }

    .helt__scene {
      grid-column: 1;
      grid-row: 3;
      width: min(78%, 420px);
      justify-self: center;
      margin-top: var(--r-2);
    }

    .helt__form {
      grid-row: 3;
    }

    .helt__tekst {
      grid-column: 1;
      grid-row: 5;
      padding: var(--r-6) 0 0;
    }

    .helt__statement {
      max-width: none;
    }
  }
</style>
