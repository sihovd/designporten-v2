---
/**
 * The three paths as three doors into the same workshop
 * (information-architecture.md#the-three-paths-not-three-generic-cards).
 * One wide band in three unequal zones, each in its own material state:
 * finished objects, the same kind of object in the editor, a pencil sketch.
 * Hover or focus widens a zone and moves its object one step on; on touch
 * the zones stack and show their end state. Each zone is one link.
 */
import Ikon from '@/components/Ikon.astro';
import Konseptbilde from '@/components/Konseptbilde.astro';
import { bakgrunner, utklippbilder } from '@/lib/ressurser';

const skisse = bakgrunner.prosess;
---

<section class="dorer" id="dorer" aria-labelledby="dorer-tittel">
  <div class="dorer__hode">
    <h2 id="dorer-tittel">Tre veier inn i verkstedet</h2>
    <p class="mono dorer__meta">Velg der du står</p>
  </div>

  <div class="dorer__band">
    <a class="dor dor--finn" href="/produkter/">
      <div class="dor__scene" aria-hidden="true">
        <div class="dor__objekter">
          <Konseptbilde bilde={utklippbilder.fasettpotte} class="dor__o dor__o--1" merke={false} />
          <Konseptbilde bilde={utklippbilder.spiralvase} class="dor__o dor__o--2" merke={false} />
          <Konseptbilde bilde={utklippbilder.telefonstativ} class="dor__o dor__o--3" merke={false} />
        </div>
        <span class="dor__merke mono">Konseptbilde</span>
      </div>
      <div class="dor__tekst">
        <span class="mono dor__nr">01 · Ferdig</span>
        <span class="dor__navn">Finn noe</span>
        <span class="dor__linje">Ting vi allerede har tegnet og printet. Se hva som finnes.</span>
        <span class="dor__handling">
          Se produktene <Ikon navn="pil-hoyre" storrelse={18} />
        </span>
      </div>
    </a>

    <a class="dor dor--lag verksted-flate" href="/skaperverksted/">
      <div class="dor__scene dor__rutenett" aria-hidden="true">
        <div class="dor__arbeid">
          <Konseptbilde bilde={utklippbilder.nokkelring} class="dor__skilt" merke={false} />
          <span class="dor__utvalg">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </span>
        </div>
        <span class="dor__merke mono">Konseptbilde</span>
      </div>
      <div class="dor__tekst">
        <span class="mono dor__nr">02 · Skaperverksted</span>
        <span class="dor__navn">Lag noe</span>
        <span class="dor__linje">Design skiltet, navnet eller formen selv, i nettleseren, i millimeter.</span>
        <span class="dor__handling">
          Gå til Skaperverksted <Ikon navn="pil-hoyre" storrelse={18} />
        </span>
      </div>
    </a>

    <a class="dor dor--ide" href="/spesialdesign/">
      <div class="dor__scene" aria-hidden="true">
        <div class="dor__ark" style={`--ark: url(${skisse.src})`}>
          <svg class="dor__hjelpelinjer" viewBox="0 0 400 533" preserveAspectRatio="none">
            <line x1="192" y1="120" x2="192" y2="420" pathLength="1"></line>
            <line x1="92" y1="168" x2="292" y2="168" pathLength="1"></line>
            <line x1="70" y1="300" x2="316" y2="300" pathLength="1"></line>
            <line x1="92" y1="388" x2="292" y2="388" pathLength="1"></line>
          </svg>
        </div>
        <span class="dor__merke mono">Konseptbilde</span>
      </div>
      <div class="dor__tekst">
        <span class="mono dor__nr">03 · Spesialdesign</span>
        <span class="dor__navn">Har du en idé?</span>
        <span class="dor__linje">
          Send en skisse, et mål eller et bilde. Vi gjør det til noe du kan holde i.
        </span>
        <span class="dor__handling">
          Fortell oss ideen <Ikon navn="pil-hoyre" storrelse={18} />
        </span>
      </div>
    </a>
  </div>
</section>

<style>
  /* Full-bleed: the band is the width of the browser, the text keeps the gutters. */
  .dorer {
    padding-block: var(--r-8) 0;
  }

  .dorer__hode {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--r-3);
    padding: 0 var(--gutter) var(--r-5);
  }

  .dorer__hode h2 {
    /* Long uppercase words must fit a 320 px screen. */
    font-size: min(var(--fs-h1), 10.4vw);
    font-stretch: 122%;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
    text-transform: uppercase;
    max-width: 14ch;
  }

  .dorer__meta {
    color: var(--dempet);
  }

  .dorer__band {
    display: grid;
    grid-template-columns: 1.15fr 1.45fr 1fr;
    min-height: clamp(540px, 74svh, 820px);
    border-top: 1px solid var(--kant);
    transition: grid-template-columns var(--t-inngang) var(--ease-ut);
  }

  .dorer__band:has(.dor--finn:is(:hover, :focus-visible)) {
    grid-template-columns: 1.8fr 1.1fr 0.8fr;
  }

  .dorer__band:has(.dor--lag:is(:hover, :focus-visible)) {
    grid-template-columns: 0.9fr 2fr 0.8fr;
  }

  .dorer__band:has(.dor--ide:is(:hover, :focus-visible)) {
    grid-template-columns: 0.9fr 1.1fr 1.7fr;
  }

  .dor {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    color: var(--fg);
    text-decoration: none;
  }

  .dor--finn {
    background: var(--kalk);
  }

  .dor--ide {
    background: var(--flate);
  }

  .dor:focus-visible {
    outline-offset: -4px;
  }

  .dor__scene {
    position: relative;
    flex: 1;
    min-height: 260px;
  }

  .dor__merke {
    position: absolute;
    left: var(--r-4);
    top: var(--r-3);
    padding: 3px 8px;
    background: var(--blekk);
    color: #fff;
    font-size: var(--fs-mono-liten);
  }

  .dor__tekst {
    display: grid;
    gap: var(--r-2);
    padding: var(--r-5) var(--r-6) var(--r-7);
  }

  .dor--finn .dor__tekst {
    padding-left: var(--gutter);
  }

  .dor--ide .dor__tekst {
    padding-right: var(--gutter);
  }

  .dor__nr {
    color: var(--fg-dempet);
    font-size: var(--fs-mono-liten);
  }

  .dor__navn {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    font-stretch: 118%;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .dor__linje {
    color: var(--fg-dempet);
    max-width: 34ch;
  }

  .dor__handling {
    display: inline-flex;
    align-items: center;
    gap: var(--r-2);
    margin-top: var(--r-2);
    color: var(--lenke);
    font-weight: 620;
  }

  .dor:hover .dor__handling {
    text-decoration: underline;
  }

  .dor__handling :global(svg) {
    transition: transform var(--t-rask) var(--ease-ut);
  }

  .dor:is(:hover, :focus-visible) .dor__handling :global(svg) {
    transform: translateX(4px);
  }

  /* ---------- 01 FINN NOE: finished objects ---------- */
  .dor__objekter {
    position: absolute;
    inset: 12% 6% 0;
  }

  .dor__objekter > :global(.dor__o) {
    position: absolute;
    bottom: 4%;
    transition:
      transform var(--t-inngang) var(--ease-ut),
      opacity var(--t-inngang) var(--ease-ut);
  }

  .dor__objekter :global(img) {
    object-fit: contain;
  }

  .dor__objekter > :global(.dor__o--1) {
    left: 0;
    width: 46%;
    transform: translateX(-10%);
  }

  .dor__objekter > :global(.dor__o--2) {
    left: 27%;
    width: 50%;
    bottom: 8%;
    z-index: 1;
  }

  .dor__objekter > :global(.dor__o--3) {
    right: 0;
    width: 40%;
    transform: translateX(14%);
    opacity: 0.9;
  }

  .dor--finn:is(:hover, :focus-visible) :global(.dor__o--1) {
    transform: translateX(0) translateY(-4%);
  }

  .dor--finn:is(:hover, :focus-visible) :global(.dor__o--2) {
    transform: translateY(-6%) scale(1.04);
  }

  .dor--finn:is(:hover, :focus-visible) :global(.dor__o--3) {
    transform: translateX(0) translateY(-4%);
    opacity: 1;
  }

  /* ---------- 02 LAG NOE: the object on the measurement grid ---------- */
  .dor__rutenett {
    background-color: var(--verksted);
    background-image:
      linear-gradient(var(--linje-mork) 1px, transparent 1px),
      linear-gradient(90deg, var(--linje-mork) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--linje-mork) 45%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--linje-mork) 45%, transparent) 1px, transparent 1px);
    background-size:
      50px 50px,
      50px 50px,
      10px 10px,
      10px 10px;
    background-position: center;
  }

  .dor__arbeid {
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(68%, 320px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  .dor__arbeid > :global(.dor__skilt) {
    position: absolute;
    inset: 0;
    transition: filter var(--t-inngang) var(--ease-ut);
    filter: grayscale(1) brightness(1.35) contrast(0.55);
  }

  .dor--lag:is(:hover, :focus-visible) :global(.dor__skilt) {
    filter: none;
  }

  /* Selection box with handles, as in the editor. */
  .dor__utvalg {
    position: absolute;
    inset: 26% 6% 24% 6%;
    border: 1px dashed var(--dp-cyan);
    transition: opacity var(--t-inngang) var(--ease-ut);
  }

  .dor__utvalg i {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--verksted);
    border: 1.5px solid var(--dp-cyan);
  }

  .dor__utvalg i:nth-child(1) {
    left: -5px;
    top: -5px;
  }

  .dor__utvalg i:nth-child(2) {
    right: -5px;
    top: -5px;
  }

  .dor__utvalg i:nth-child(3) {
    left: -5px;
    bottom: -5px;
  }

  .dor__utvalg i:nth-child(4) {
    right: -5px;
    bottom: -5px;
  }

  .dor--lag:is(:hover, :focus-visible) .dor__utvalg {
    opacity: 0.35;
  }

  .dor--lag .dor__merke {
    background: var(--tekst-mork);
    color: var(--verksted);
  }

  /* ---------- 03 HAR DU EN IDÉ?: a pencil sketch ---------- */
  .dor__ark {
    position: absolute;
    left: 50%;
    top: 50%;
    height: min(80%, 320px);
    max-width: 80%;
    aspect-ratio: 400 / 533;
    background-image: var(--ark);
    background-size: 400% 100%;
    background-position: 0 0;
    box-shadow: var(--skygge-objekt);
    transform: translate(-50%, -48%) rotate(-3deg);
    transition: transform var(--t-inngang) var(--ease-ut);
  }

  .dor--ide:is(:hover, :focus-visible) .dor__ark {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .dor__hjelpelinjer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--dp-lilla);
    stroke-width: 1.2;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--t-inngang) var(--ease-ut);
  }

  .dor__hjelpelinjer line {
    vector-effect: non-scaling-stroke;
  }

  .dor--ide:is(:hover, :focus-visible) .dor__hjelpelinjer {
    stroke-dashoffset: 0;
  }

  /* ---------- Touch and narrow screens: stacked, end states ---------- */
  @media (max-width: 860px), (hover: none) {
    .dorer__band,
    .dorer__band:has(.dor:is(:hover, :focus-visible)) {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .dor__scene {
      min-height: clamp(240px, 62vw, 420px);
    }

    .dor .dor__tekst {
      padding-inline: var(--gutter);
    }

    .dor__objekter > :global(.dor__o--1),
    .dor__objekter > :global(.dor__o--3) {
      transform: none;
    }

    .dor :global(.dor__skilt) {
      filter: none;
    }

    .dor__utvalg {
      opacity: 0.35;
    }

    .dor__hjelpelinjer {
      stroke-dashoffset: 0;
    }

    .dor__ark {
      transform: translate(-50%, -50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dorer__band,
    .dor * {
      transition: none !important;
    }
  }
</style>
