---
/**
 * Selected products on the homepage (information-architecture.md#homepage, 5).
 * An editorial composition instead of one more centred grid: the first
 * product large across the full width with its real specifications layered
 * beside it, then the rest as a horizontal row of the preserved product
 * cards. The featured product is the vase the hero printed, so the object
 * built at the top of the page arrives here as something you can order.
 *
 * Confirmed products come first. Until any are confirmed the section shows
 * the catalogue's first products, each visibly marked «Plassholder», with a
 * line saying so. No sizes, prices or colours are shown that the data lacks.
 */
import Ikon from '@/components/Ikon.astro';
import Konseptbilde from '@/components/Konseptbilde.astro';
import ProduktRutenett from '@/components/produkt/ProduktRutenett.astro';
import { hentProdukter } from '@/lib/handel/katalog';
import { formaterMal } from '@/lib/handel/visning';
import { utklippbilder } from '@/lib/ressurser';
import { silhuett } from '@/components/showroom/bygg/vasegeometri';

const alle = await hentProdukter();
const bekreftede = alle.filter((p) => p.status === 'bekreftet');
const utvalg = (bekreftede.length ? bekreftede : alle).slice(0, 9);
const bareplassholdere = utvalg.every((p) => p.status === 'plassholder');
const [fremhevet, ...resten] = utvalg;
const mal = fremhevet ? formaterMal(fremhevet.mal) : null;
// The spiral vase cut-out carries a baked-in shadow; cut it to the vase as the hero does.
const klipp = fremhevet?.bilde.src === utklippbilder.spiralvase.src ? silhuett(0) : null;
---

{fremhevet && (
  <section class="utvalg" aria-labelledby="utvalg-tittel">
    <div class="utvalg__hode">
      <h2 id="utvalg-tittel">Fra produktene</h2>
      <a class="utvalg__alle" href="/produkter/">
        Se alle produktene <Ikon navn="pil-hoyre" storrelse={18} />
      </a>
    </div>

    <article
      class="utvalg__scene"
      data-rulle="gjennom"
      data-rulle-rolig="0.5"
      aria-labelledby="utvalg-fremhevet"
    >
      <div
        class:list={['utvalg__objekt', { 'utvalg__objekt--klippet': klipp }]}
        style={klipp ? `--silhuett: ${klipp}` : undefined}
      >
        {klipp && <span class="utvalg__skygge" aria-hidden="true" />}
        <Konseptbilde bilde={fremhevet.bilde} sizes="(min-width: 900px) 55vw, 90vw" />
      </div>
      <div class="utvalg__tekst">
        <p class="mono utvalg__nr">
          Utvalgt · {fremhevet.kategoriNavn}
          {fremhevet.status === 'plassholder' && <span class="utvalg__merke">Plassholder</span>}
        </p>
        <h3 id="utvalg-fremhevet" class="utvalg__navn">
          <a href={fremhevet.href}>{fremhevet.navn}</a>
        </h3>
        <p class="utvalg__beskrivelse">{fremhevet.kortBeskrivelse}</p>
        <dl class="utvalg__spes">
          {fremhevet.materialer.length > 0 && (
            <div>
              <dt class="mono">Materiale</dt>
              <dd>{fremhevet.materialer.map((m) => m.type).join(' · ')}</dd>
            </div>
          )}
          {fremhevet.farger.length > 0 && (
            <div>
              <dt class="mono">Farger</dt>
              <dd class="utvalg__farger">
                {fremhevet.farger.map((f) => (
                  <span class="utvalg__farge" style={`--f:${f.hex}`} title={f.navn}>
                    <span class="visuelt-skjult">{f.navn}</span>
                  </span>
                ))}
              </dd>
            </div>
          )}
          <div>
            <dt class="mono">Mål</dt>
            <dd>{mal ?? 'Ikke fastsatt ennå'}</dd>
          </div>
        </dl>
        <a class="utvalg__lenke" href={fremhevet.href} aria-describedby="utvalg-fremhevet">
          Se produktet <Ikon navn="pil-hoyre" storrelse={18} />
        </a>
      </div>
    </article>

    {resten.length > 0 && (
      <div class="utvalg__rad">
        <div class="utvalg__radhode">
          <p class="mono">Flere fra produktene</p>
          {bareplassholdere && (
            <p class="utvalg__merknad">
              Produktene er plassholdere med konseptbilder til det ekte utvalget er klart.
            </p>
          )}
        </div>
        <ProduktRutenett produkter={resten} nivaa="h3" etikett="Utvalgte produkter" class="utvalg__kort" />
      </div>
    )}
  </section>
)}

<style>
  .utvalg {
    padding-block: var(--r-seksjon) var(--r-8);
    overflow-x: clip;
  }

  .utvalg__hode {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--r-3);
    padding-inline: var(--sidekant);
  }

  .utvalg__hode h2 {
    font-size: var(--fs-h1);
    font-stretch: 122%;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .utvalg__alle,
  .utvalg__lenke {
    display: inline-flex;
    align-items: center;
    gap: var(--r-2);
    min-height: var(--mal-beroring);
    font-weight: 620;
    text-decoration: none;
  }

  .utvalg__alle:hover,
  .utvalg__lenke:hover {
    text-decoration: underline;
  }

  .utvalg__alle :global(svg),
  .utvalg__lenke :global(svg) {
    transition: transform var(--t-rask) var(--ease-ut);
  }

  .utvalg__alle:is(:hover, :focus-visible) :global(svg),
  .utvalg__lenke:is(:hover, :focus-visible) :global(svg) {
    transform: translateX(4px);
  }

  /* ---------- The featured product: oversized, on a full-width band ---------- */
  .utvalg__scene {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    margin-top: var(--r-6);
    padding-inline: var(--sidekant) 0;
    min-height: clamp(460px, 62svh, 720px);
    background: linear-gradient(var(--kalk), var(--kalk)) 0 12% / 100% 76% no-repeat;
  }

  .utvalg__tekst {
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: var(--r-3);
    justify-items: start;
    padding-block: var(--r-7);
    transform: translateY(calc((0.5 - var(--p, 0.5)) * -24px));
  }

  .utvalg__nr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--r-3);
    color: var(--dempet);
  }

  .utvalg__merke {
    padding: 2px 6px;
    border: 1px solid currentColor;
    color: var(--advarsel);
  }

  .utvalg__navn {
    font-size: var(--fs-h1);
    font-stretch: 118%;
    font-weight: 780;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .utvalg__navn a {
    color: var(--blekk);
    text-decoration: none;
  }

  .utvalg__navn a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  .utvalg__beskrivelse {
    max-width: 40ch;
    color: var(--dempet);
    font-size: var(--fs-ingress);
  }

  .utvalg__spes {
    display: grid;
    gap: var(--r-2);
    margin: var(--r-3) 0 0;
    padding-top: var(--r-3);
    border-top: 1px solid var(--kant-sterk);
    min-width: min(100%, 320px);
  }

  .utvalg__spes > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: center;
    gap: var(--r-3);
  }

  .utvalg__spes dt {
    color: var(--dempet);
    font-size: var(--fs-mono-liten);
  }

  .utvalg__spes dd {
    margin: 0;
    font-size: var(--fs-liten);
  }

  .utvalg__farger {
    display: flex;
    gap: 6px;
  }

  .utvalg__farge {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--f);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.18);
  }

  /* The object is larger than its band and runs off the right edge. */
  .utvalg__objekt {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    justify-self: end;
    width: min(62vw, 880px);
    margin-right: -6vw;
    transform: translateY(calc((0.5 - var(--p, 0.5)) * 70px)) scale(calc(0.94 + var(--p, 0.5) * 0.1));
    transform-origin: 50% 80%;
  }

  .utvalg__objekt :global(img) {
    aspect-ratio: 1;
    object-fit: contain;
    filter: drop-shadow(0 30px 28px rgb(24 23 28 / 0.18));
  }

  .utvalg__objekt--klippet :global(img) {
    clip-path: var(--silhuett);
    filter: none;
  }

  .utvalg__skygge {
    position: absolute;
    left: 18%;
    width: 46%;
    top: 84%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(24 23 28 / 0.26), rgb(24 23 28 / 0));
  }

  .utvalg__objekt :global(.konseptbilde__merke) {
    left: 12%;
    top: 14%;
  }

  /* ---------- The rest: a horizontal row of the preserved cards ---------- */
  .utvalg__rad {
    margin-top: var(--r-7);
  }

  .utvalg__radhode {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--r-2) var(--r-5);
    padding-inline: var(--sidekant);
    margin-bottom: var(--r-4);
  }

  .utvalg__radhode .mono {
    color: var(--dempet);
  }

  .utvalg__merknad {
    color: var(--dempet);
    font-size: var(--fs-liten);
  }

  .utvalg :global(.produktrutenett.utvalg__kort) {
    display: flex;
    justify-content: flex-start;
    gap: var(--kort-gap);
    width: auto;
    margin: 0;
    padding: 4px var(--sidekant) var(--r-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--sidekant);
    scrollbar-width: thin;
    scrollbar-color: var(--kant-sterk) transparent;
  }

  .utvalg :global(.utvalg__kort > li) {
    flex: 0 0 min(var(--kort-b), 58vw);
    scroll-snap-align: start;
  }

  @media (max-width: 860px) {
    .utvalg__scene {
      grid-template-columns: 1fr;
      padding-inline: var(--sidekant);
      background-position: 0 0;
      background-size: 100% 100%;
      padding-bottom: var(--r-5);
    }

    .utvalg__objekt {
      grid-row: 1;
      grid-column: 1;
      justify-self: center;
      width: min(100%, 520px);
      margin: 0;
    }

    .utvalg__tekst {
      grid-row: 2;
      padding-block: 0 var(--r-4);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .utvalg__objekt,
    .utvalg__tekst {
      transform: none;
    }
  }
</style>
