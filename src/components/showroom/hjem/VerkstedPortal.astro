---
/**
 * The way into Skaperverksted from the homepage (design revision 2026-10-02,
 * §8 and §11). The light page darkens softly into the graphite workshop: a
 * long gradient, no shapes or doors, and the content settles in as it
 * arrives. Inside, the four Forge tools as compact cards.
 *
 * Reduced motion: the same gradient, content shown at once.
 */
import Knapp from '@/components/Knapp.astro';
import VerktoyKort from '@/components/showroom/verksted/VerktoyKort.astro';
import { verktoy } from '@/components/showroom/verksted/verktoy';
---

<section class="portal" aria-labelledby="portal-tittel" data-rulle="inn" data-rulle-rolig="1">
  <div class="portal__overgang" aria-hidden="true"></div>
  <div class="portal__flate" data-mork>
    <div class="portal__rutenett" aria-hidden="true"></div>
    <div class="portal__innhold">
      <div class="portal__hode">
        <div class="portal__tekst">
          <p class="etikett portal__etikett">Skaperverksted</p>
          <h2 id="portal-tittel" class="portal__tittel">
            Lag det selv, i ekte millimeter
          </h2>
          <p class="portal__ingress">
            Bygg i nettleseren, se modellen i 3D mens du jobber, og last ned filen eller bestill den printet
            fra oss.
          </p>
        </div>
        <Knapp href="/skaperverksted/">Start å skape</Knapp>
      </div>
      <ul class="portal__verktoy" role="list">
        {verktoy.map((v) => (
          <li>
            <VerktoyKort verktoy={v} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .portal {
    --p: 1;
    position: relative;
    color: var(--tekst-mork);
  }

  /* The light page darkens over a long distance, without a hard edge. */
  .portal__overgang {
    height: clamp(120px, 22vh, 240px);
    background: linear-gradient(
      180deg,
      var(--papir) 0%,
      color-mix(in srgb, var(--papir) 72%, var(--verksted)) 34%,
      color-mix(in srgb, var(--papir) 30%, var(--verksted)) 68%,
      var(--verksted) 100%
    );
  }

  .portal__flate {
    position: relative;
    isolation: isolate;
    padding-block: var(--r-6) var(--r-seksjon);
    background: var(--verksted);
  }

  .portal__rutenett {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--linje-mork) 1px, transparent 1px),
      linear-gradient(90deg, var(--linje-mork) 1px, transparent 1px);
    background-size: 80px 80px;
    background-position: 50% 0;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, #000 10%, transparent 75%);
    opacity: calc(0.15 + var(--p) * 0.35);
  }

  .portal__innhold {
    display: grid;
    gap: var(--r-6);
    width: min(var(--innhold-maks), 100% - 2 * var(--gutter));
    margin-inline: auto;
    opacity: clamp(0, calc(var(--p) * 1.6 - 0.2), 1);
    transform: translate3d(0, calc((1 - var(--p)) * 24px), 0);
  }

  .portal__hode {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--r-5);
  }

  .portal__tekst {
    display: grid;
    gap: var(--r-3);
  }

  .portal__etikett {
    color: var(--dp-cyan);
  }

  .portal__tittel {
    color: var(--tekst-mork);
    font-size: var(--fs-h2);
    max-width: 20ch;
  }

  .portal__ingress {
    max-width: 50ch;
    color: var(--dempet-mork);
  }

  .portal__verktoy {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--r-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1100px) {
    .portal__verktoy {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .portal__verktoy {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal__innhold {
      opacity: 1;
      transform: none;
    }
  }
</style>
