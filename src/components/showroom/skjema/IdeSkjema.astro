---
/**
 * The idea form (information-architecture.md#idea-form) and its short
 * version for Kontakt. Short and human; only description, name and e-mail
 * are required. Posts to /api/foresporsel, which delivers by e-mail
 * (src/lib/skjema/levering.ts). Works without JavaScript; with it, the form
 * sends in place, shows errors by the fields and the receipt inline.
 */
import Knapp from '@/components/Knapp.astro';
import Ikon from '@/components/Ikon.astro';
import Kvittering from './Kvittering.astro';
import { startpunkter } from '../startpunkter';
import { antallValg } from './tolk';

interface Props {
  variant?: 'full' | 'kort';
  kundetype?: 'privat' | 'bedrift';
  id?: string;
}

const { variant = 'full', kundetype = 'privat', id = 'skjema' } = Astro.props;
const full = variant === 'full';
const f = (navn: string) => `${id}-${navn}`;
const forste = startpunkter[0]!;
---

<div class="skjema-ramme" data-skjema-ramme>
  <form
    class="skjema"
    id={id}
    method="post"
    action="/api/foresporsel/"
    enctype="multipart/form-data"
    data-skjema
    data-start="ide"
    novalidate
  >
    <input type="hidden" name="skjema" value={full ? 'ide' : 'kontakt'} />

    <div class="skjema__oppsummering" role="alert" tabindex="-1" data-oppsummering hidden>
      <p>
        <strong>Noe mangler før vi kan sende:</strong>
      </p>
      <ul data-oppsummering-liste></ul>
    </div>

    {full && (
      <fieldset class="skjema__gruppe skjema__start">
        <legend>Hva har du å starte med?</legend>
        <div class="skjema__startvalg">
          {startpunkter.map((s, i) => (
            <label class="skjema__startknapp">
              <input type="radio" name="start" value={s.id} checked={i === 0} data-eksempel={s.eksempel} />
              <span>{s.tittel}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}

    <div class="skjema__felt" data-felt="beskrivelse" data-fremhev="ide">
      <label for={f('beskrivelse')}>
        {full ? 'Hva vil du lage?' : 'Hva gjelder det?'} <span class="skjema__krav">Må fylles ut</span>
      </label>
      <textarea
        id={f('beskrivelse')}
        name="beskrivelse"
        rows={full ? 6 : 5}
        required
        maxlength="8000"
        placeholder={full ? forste.eksempel : 'For eksempel: jeg lurer på om dere kan printe noe i PETG.'}
        aria-describedby={f('beskrivelse-feil')}
        data-beskrivelse
      ></textarea>
      <p class="skjema__feil" id={f('beskrivelse-feil')} data-feil-for="beskrivelse"></p>
    </div>

    {full && (
      <div class="skjema__felt" data-felt="filer" data-fremhev="tegning modell del">
        <label for={f('filer')}>Last opp bilder, skisser, mål eller filer</label>
        <p class="skjema__hjelp" id={f('filer-hjelp')}>
          JPG, PNG, HEIC, PDF, STL, 3MF, STEP eller OBJ. Opptil 8 filer, 15 MB per fil. På mobil kan du ta
          bilde direkte.
        </p>
        <div class="skjema__slipp" data-slipp>
          <Ikon navn="last-opp" storrelse={22} />
          <span>Dra filer hit, eller</span>
          <input
            id={f('filer')}
            name="filer"
            type="file"
            multiple
            accept=".jpg,.jpeg,.png,.heic,.webp,.pdf,.stl,.3mf,.step,.stp,.obj,.svg,image/*"
            aria-describedby={`${f('filer-hjelp')} ${f('filer-feil')}`}
            data-filer
          />
        </div>
        <ul class="skjema__filliste" data-filliste aria-live="polite" />
        <p class="skjema__feil" id={f('filer-feil')} data-feil-for="filer" />
      </div>
    )}

    {full && (
      <div class="skjema__rad">
        <div class="skjema__felt" data-felt="mal" data-fremhev="del">
          <label for={f('mal')}>Omtrentlige mål</label>
          <input
            id={f('mal')}
            name="mal"
            type="text"
            maxlength="400"
            placeholder="B × H × D i mm, eller fritekst"
            autocomplete="off"
          />
        </div>
        <div class="skjema__felt">
          <label for={f('antall')}>Antall</label>
          <select id={f('antall')} name="antall">
            <option value="">Velg</option>
            {antallValg.map((a) => (
              <option value={a}>{a}</option>
            ))}
          </select>
        </div>
        <div class="skjema__felt">
          <label for={f('frist')}>Til når?</label>
          <input id={f('frist')} name="frist" type="date" data-frist />
          <label class="skjema__avkryss">
            <input type="checkbox" name="ingenHast" value="ja" data-ingen-hast /> Ingen hast
          </label>
        </div>
      </div>
    )}

    <div class="skjema__rad">
      <div class="skjema__felt" data-felt="navn">
        <label for={f('navn')}>
          Navn <span class="skjema__krav">Må fylles ut</span>
        </label>
        <input
          id={f('navn')}
          name="navn"
          type="text"
          required
          maxlength="200"
          autocomplete="name"
          aria-describedby={f('navn-feil')}
        />
        <p class="skjema__feil" id={f('navn-feil')} data-feil-for="navn"></p>
      </div>
      <div class="skjema__felt" data-felt="epost">
        <label for={f('epost')}>
          E-post <span class="skjema__krav">Må fylles ut</span>
        </label>
        <input
          id={f('epost')}
          name="epost"
          type="email"
          required
          maxlength="200"
          autocomplete="email"
          aria-describedby={f('epost-feil')}
        />
        <p class="skjema__feil" id={f('epost-feil')} data-feil-for="epost"></p>
      </div>
      <div class="skjema__felt">
        <label for={f('telefon')}>Telefon</label>
        <input id={f('telefon')} name="telefon" type="tel" maxlength="40" autocomplete="tel" />
      </div>
    </div>

    {full && (
      <fieldset class="skjema__gruppe">
        <legend>Privat eller bedrift?</legend>
        <div class="skjema__valgrad">
          <label class="skjema__avkryss">
            <input
              type="radio"
              name="kundetype"
              value="privat"
              checked={kundetype === 'privat'}
              data-kundetype
            />{' '}
            Privat
          </label>
          <label class="skjema__avkryss">
            <input
              type="radio"
              name="kundetype"
              value="bedrift"
              checked={kundetype === 'bedrift'}
              data-kundetype
            />{' '}
            Bedrift
          </label>
        </div>
        <div class="skjema__felt skjema__firma" data-firma>
          <label for={f('firma')}>Firmanavn</label>
          <input id={f('firma')} name="firma" type="text" maxlength="200" autocomplete="organization" />
        </div>
      </fieldset>
    )}

    <!-- Left empty by people; bots fill it in. -->
    <div class="skjema__krukke" aria-hidden="true">
      <label for={f('nettside')}>Nettside</label>
      <input id={f('nettside')} name="nettside" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="skjema__send">
      <Knapp type="submit" data-send>
        {full ? 'Send ideen' : 'Send meldingen'}
      </Knapp>
      <p class="skjema__personvern">
        Vi bruker det du sender bare til å svare på henvendelsen. Les mer om{' '}
        <a href="/personvern/">personvern</a>.
      </p>
    </div>
    <p class="skjema__status" role="status" data-status></p>
  </form>

  <template data-kvittering-mal>
    <Kvittering type={full ? 'ide' : 'kontakt'} referanse="DP-00000000-X" kanal="fil" />
  </template>
</div>

<script>
  interface Svar {
    ok: boolean;
    referanse?: string;
    kanal?: 'epost' | 'fil';
    feil?: Record<string, string>;
    grunn?: string;
  }

  const feltnavn: Record<string, string> = {
    beskrivelse: 'Beskrivelse',
    navn: 'Navn',
    epost: 'E-post',
    filer: 'Filer',
  };

  document.querySelectorAll<HTMLFormElement>('[data-skjema]').forEach((skjema) => {
    const ramme = skjema.closest<HTMLElement>('[data-skjema-ramme]')!;
    const oppsummering = skjema.querySelector<HTMLElement>('[data-oppsummering]')!;
    const liste = skjema.querySelector<HTMLElement>('[data-oppsummering-liste]')!;
    const status = skjema.querySelector<HTMLElement>('[data-status]')!;
    const send = skjema.querySelector<HTMLButtonElement>('[data-send]')!;
    const beskrivelse = skjema.querySelector<HTMLTextAreaElement>('[data-beskrivelse]')!;

    // ---- Starting point: emphasise the right fields ----
    const startvalg = [...skjema.querySelectorAll<HTMLInputElement>('input[name="start"]')];
    function settStart(verdi: string) {
      const valg = startvalg.find((r) => r.value === verdi);
      if (!valg) return;
      valg.checked = true;
      skjema.dataset.start = verdi;
      beskrivelse.placeholder = valg.dataset.eksempel ?? '';
    }
    startvalg.forEach((r) => r.addEventListener('change', () => settStart(r.value)));
    const fraAdresse = new URLSearchParams(window.location.search).get('start');
    if (fraAdresse) settStart(fraAdresse);
    // Links on the same page (?start=… with #skjema) also set it.
    document.querySelectorAll<HTMLAnchorElement>('a[href*="?start="]').forEach((a) => {
      const url = new URL(a.href);
      if (url.pathname !== window.location.pathname) return;
      a.addEventListener('click', (e) => {
        e.preventDefault();
        settStart(url.searchParams.get('start') ?? '');
        history.replaceState(null, '', url.href);
        skjema.scrollIntoView({ block: 'start' });
        startvalg.find((r) => r.checked)?.focus({ preventScroll: true });
      });
    });

    // ---- Company name only for businesses ----
    const firma = skjema.querySelector<HTMLElement>('[data-firma]');
    const kundetyper = [...skjema.querySelectorAll<HTMLInputElement>('[data-kundetype]')];
    function visFirma() {
      if (firma) firma.hidden = !kundetyper.some((k) => k.checked && k.value === 'bedrift');
    }
    kundetyper.forEach((k) => k.addEventListener('change', visFirma));
    visFirma();

    // ---- «Ingen hast» disables the date ----
    const frist = skjema.querySelector<HTMLInputElement>('[data-frist]');
    const ingenHast = skjema.querySelector<HTMLInputElement>('[data-ingen-hast]');
    ingenHast?.addEventListener('change', () => {
      if (frist) frist.disabled = ingenHast.checked;
    });

    // ---- Files: drag and drop, list of chosen files ----
    const filer = skjema.querySelector<HTMLInputElement>('[data-filer]');
    const slipp = skjema.querySelector<HTMLElement>('[data-slipp]');
    const filliste = skjema.querySelector<HTMLElement>('[data-filliste]');
    function kb(n: number) {
      return n > 1024 * 1024
        ? `${(n / 1024 / 1024).toFixed(1)} MB`
        : `${Math.max(1, Math.round(n / 1024))} kB`;
    }
    function tegnFiler() {
      if (!filer || !filliste) return;
      filliste.replaceChildren(
        ...[...(filer.files ?? [])].map((fil, i) => {
          const li = document.createElement('li');
          const navn = document.createElement('span');
          navn.textContent = fil.name;
          const storrelse = document.createElement('span');
          storrelse.className = 'mono';
          storrelse.textContent = kb(fil.size);
          const fjern = document.createElement('button');
          fjern.type = 'button';
          fjern.textContent = 'Fjern';
          fjern.setAttribute('aria-label', `Fjern ${fil.name}`);
          fjern.addEventListener('click', () => {
            const dt = new DataTransfer();
            [...(filer.files ?? [])].forEach((f, k) => k !== i && dt.items.add(f));
            filer.files = dt.files;
            tegnFiler();
            filer.focus();
          });
          li.append(navn, storrelse, fjern);
          return li;
        }),
      );
    }
    filer?.addEventListener('change', tegnFiler);
    if (slipp && filer) {
      slipp.addEventListener('dragover', (e) => {
        e.preventDefault();
        slipp.classList.add('over');
      });
      slipp.addEventListener('dragleave', () => slipp.classList.remove('over'));
      slipp.addEventListener('drop', (e) => {
        e.preventDefault();
        slipp.classList.remove('over');
        const dt = new DataTransfer();
        [...(filer.files ?? [])].forEach((f) => dt.items.add(f));
        [...(e.dataTransfer?.files ?? [])].forEach((f) => dt.items.add(f));
        filer.files = dt.files;
        tegnFiler();
      });
    }

    // ---- Errors ----
    function nullstillFeil() {
      oppsummering.hidden = true;
      liste.replaceChildren();
      skjema.querySelectorAll<HTMLElement>('[data-feil-for]').forEach((el) => (el.textContent = ''));
      skjema.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    }

    function visFeil(feil: Record<string, string>) {
      nullstillFeil();
      for (const [navn, melding] of Object.entries(feil)) {
        const felt = skjema.querySelector<HTMLElement>(`[name="${navn}"]`);
        const tekst = skjema.querySelector<HTMLElement>(`[data-feil-for="${navn}"]`);
        if (tekst) tekst.textContent = melding;
        felt?.setAttribute('aria-invalid', 'true');
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${felt?.id ?? ''}`;
        a.textContent = `${feltnavn[navn] ?? navn}: ${melding}`;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          felt?.focus();
        });
        li.append(a);
        liste.append(li);
      }
      oppsummering.hidden = false;
      oppsummering.focus();
    }

    function sjekkLokalt(): Record<string, string> {
      const feil: Record<string, string> = {};
      const verdi = (navn: string) =>
        (skjema.elements.namedItem(navn) as HTMLInputElement | null)?.value.trim() ?? '';
      if (!verdi('beskrivelse')) {
        feil.beskrivelse =
          verdi('skjema') === 'ide' ? 'Skriv litt om hva du vil lage.' : 'Skriv hva henvendelsen gjelder.';
      }
      if (!verdi('navn')) feil.navn = 'Skriv navnet ditt.';
      const epost = verdi('epost');
      if (!epost) feil.epost = 'Skriv e-postadressen din, så vi kan svare.';
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(epost)) feil.epost = 'E-postadressen ser ikke riktig ut.';
      return feil;
    }

    // ---- Send in place ----
    skjema.addEventListener('submit', async (e) => {
      e.preventDefault();
      const lokal = sjekkLokalt();
      if (Object.keys(lokal).length) {
        visFeil(lokal);
        return;
      }
      nullstillFeil();
      send.disabled = true;
      send.setAttribute('aria-busy', 'true');
      status.textContent = 'Sender …';
      try {
        const svar = await fetch(skjema.action, {
          method: 'POST',
          body: new FormData(skjema),
          headers: { accept: 'application/json' },
        });
        const data = (await svar.json()) as Svar;
        if (data.ok) {
          const mal = ramme.querySelector<HTMLTemplateElement>('[data-kvittering-mal]')!;
          const kvittering = mal.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const ref = kvittering.querySelector('[data-ref]');
          if (data.referanse && ref) ref.textContent = data.referanse;
          else kvittering.querySelector('[data-ref-linje]')?.remove();
          if (data.kanal !== 'fil') kvittering.querySelector('[data-utvikling]')?.remove();
          skjema.replaceWith(kvittering);
          kvittering.focus();
          return;
        }
        if (data.feil) visFeil(data.feil);
        status.textContent = data.grunn ?? 'Meldingen kunne ikke sendes. Prøv igjen om litt.';
      } catch {
        status.textContent = 'Fikk ikke kontakt med serveren. Sjekk nettet og prøv igjen.';
      } finally {
        send.disabled = false;
        send.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .skjema {
    display: grid;
    gap: var(--r-5);
  }

  .skjema__gruppe {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: var(--r-3);
  }

  .skjema legend,
  .skjema label:not(.skjema__avkryss, .skjema__startknapp) {
    display: block;
    margin-bottom: var(--r-2);
    font-weight: 620;
  }

  .skjema__krav {
    margin-left: var(--r-2);
    color: var(--dempet);
    font-size: var(--fs-liten);
    font-weight: 400;
  }

  .skjema__startvalg {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--r-2);
  }

  .skjema__startknapp {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--r-3);
    min-height: var(--mal-beroring);
    padding: var(--r-3) var(--r-4);
    border: 1px solid var(--kant-sterk);
    border-radius: var(--radius-panel);
    background: var(--flate);
    cursor: pointer;
    font-weight: 560;
  }

  .skjema__startknapp:has(input:checked) {
    border-color: var(--dp-lilla);
    box-shadow: inset 0 0 0 1px var(--dp-lilla);
  }

  .skjema__startknapp:has(input:focus-visible) {
    outline: 2px solid var(--fokus);
    outline-offset: 2px;
  }

  .skjema__startknapp input,
  .skjema__avkryss input {
    accent-color: var(--dp-lilla);
    width: 18px;
    height: 18px;
    margin: 0;
    flex: none;
  }

  .skjema__felt {
    min-width: 0;
  }

  .skjema__rad {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--r-5);
  }

  .skjema input[type='text'],
  .skjema input[type='email'],
  .skjema input[type='tel'],
  .skjema input[type='date'],
  .skjema select,
  .skjema textarea {
    width: 100%;
    min-height: var(--mal-beroring);
    padding: 10px 12px;
    border: 1px solid var(--kant-sterk);
    border-radius: var(--radius-felt);
    background: var(--flate);
  }

  .skjema textarea {
    resize: vertical;
    line-height: 1.5;
  }

  .skjema ::placeholder {
    color: var(--dempet);
    opacity: 1;
  }

  .skjema [aria-invalid='true'] {
    border-color: var(--feil);
    box-shadow: inset 0 0 0 1px var(--feil);
  }

  .skjema__feil {
    margin-top: var(--r-1);
    color: var(--feil);
    font-size: var(--fs-liten);
    font-weight: 560;
  }

  .skjema__feil:empty {
    display: none;
  }

  .skjema__hjelp {
    margin: calc(-1 * var(--r-1)) 0 var(--r-2);
    color: var(--dempet);
    font-size: var(--fs-liten);
  }

  /* The chosen starting point highlights the fields it needs most. */
  .skjema[data-start='ide'] [data-fremhev~='ide'],
  .skjema[data-start='tegning'] [data-fremhev~='tegning'],
  .skjema[data-start='modell'] [data-fremhev~='modell'],
  .skjema[data-start='del'] [data-fremhev~='del'] {
    padding-left: var(--r-4);
    border-left: 3px solid var(--dp-lilla);
  }

  .skjema__slipp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--r-3);
    padding: var(--r-5);
    border: 1.5px dashed var(--kant-sterk);
    border-radius: var(--radius-panel);
    background: var(--flate);
    color: var(--dempet);
  }

  .skjema__slipp:global(.over) {
    border-color: var(--dp-lilla);
    background: color-mix(in srgb, var(--dp-lilla) 6%, var(--flate));
  }

  .skjema__slipp input {
    max-width: 100%;
    color: var(--blekk);
  }

  .skjema__slipp input::file-selector-button {
    margin-right: var(--r-3);
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--kant-sterk);
    border-radius: var(--radius-pille);
    background: var(--papir);
    font: inherit;
    font-weight: 560;
    cursor: pointer;
  }

  .skjema__filliste {
    margin: var(--r-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .skjema__filliste :global(li) {
    display: flex;
    align-items: center;
    gap: var(--r-3);
    padding: 6px 0;
    border-bottom: 1px solid var(--kant);
  }

  .skjema__filliste :global(li span:first-child) {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .skjema__filliste :global(button) {
    min-height: var(--mal-min);
    border: 0;
    background: none;
    color: var(--lenke);
    text-decoration: underline;
  }

  .skjema__avkryss {
    display: inline-flex;
    align-items: center;
    gap: var(--r-2);
    min-height: var(--mal-beroring);
    margin-right: var(--r-5);
    cursor: pointer;
  }

  .skjema__valgrad {
    display: flex;
    flex-wrap: wrap;
  }

  .skjema__firma {
    max-width: 420px;
  }

  .skjema__krukke {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .skjema__send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--r-4) var(--r-5);
    padding-top: var(--r-2);
  }

  .skjema__personvern {
    color: var(--dempet);
    font-size: var(--fs-liten);
    max-width: 44ch;
  }

  .skjema__status:empty {
    display: none;
  }

  .skjema__status {
    font-weight: 560;
  }

  .skjema__oppsummering {
    padding: var(--r-4) var(--r-5);
    border: 1px solid var(--feil);
    border-left-width: 3px;
    background: var(--flate);
    color: var(--feil);
  }

  .skjema__oppsummering ul {
    margin: var(--r-2) 0 0;
    padding-left: var(--r-5);
  }

  .skjema__oppsummering :global(a) {
    color: var(--feil);
  }
