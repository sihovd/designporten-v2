---
import { nettsti, testmiljo } from '@/lib/nettsti';
/**
 * Skaperverksted editor shell page: the workshop replaces the site header
 * (spec). Full-viewport, dark workshop surface, no footer.
 */
import '@/styles/base.css';
import '@/skaperverksted/shell/verksted.css';
import { standardDelingsbilde } from '@/lib/ressurser';

interface Props {
  tittel: string;
  beskrivelse: string;
}
const { tittel, beskrivelse } = Astro.props;
const kanonisk = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="nb" class="verksted-html">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href={nettsti('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={nettsti('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={nettsti('/apple-touch-icon.png')} />
    <link rel="manifest" href={nettsti('/site.webmanifest')} />
    <title>{`${tittel} – Skaperverksted – Designporten`}</title>
    <meta name="description" content={beskrivelse} />
    {!testmiljo && <link rel="canonical" href={kanonisk.href} />}
    {testmiljo && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={`${tittel} – Designporten`} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:image" content={new URL(standardDelingsbilde.src, Astro.site).href} />
    <meta name="theme-color" content="#141317" />
    <link rel="preload" href={nettsti('/skaperverksted/fonter/archivo-800.woff')} as="fetch" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="verksted-flate">
    <slot />
    <noscript>
      <p class="verksted-laster">
        Skaperverksted trenger JavaScript. <a href={nettsti('/skaperverksted/')}>Tilbake</a>
      </p>
    </noscript>
  </body>
</html>
