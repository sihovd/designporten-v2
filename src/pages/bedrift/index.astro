---
import Side from '@/layouts/Side.astro';
import SideHode from '@/components/showroom/SideHode.astro';
import IdeSkjema from '@/components/showroom/skjema/IdeSkjema.astro';
import Konseptbilde from '@/components/Konseptbilde.astro';
import { kontakt } from '@/lib/kontakt';
import { bakgrunner } from '@/lib/ressurser';

/*
 * Services from the brief (information-architecture.md#for-bedrifter).
 * Each service will show a real Inspirasjon case when one exists; none is
 * confirmed yet, so no examples are shown. 3D scanning, office signs via CSV
 * batch and other capabilities stay out until confirmed or built.
 */
const tjenester = [
  {
    navn: 'Prototyper',
    tekst:
      'En fysisk versjon av produktet før dere bestemmer dere. Holde i, måle, teste passform og vise fram.',
    send: 'Skisse, tegning eller 3D-fil, og hva prototypen skal svare på.',
  },
  {
    navn: 'Småserier',
    tekst: 'Små opplag uten verktøy- og formkostnader. Samme fil gir samme del hver gang.',
    send: 'Filen eller en godkjent prototype, antall og materiale.',
  },
  {
    navn: 'Produktutvikling',
    tekst: 'Fra problem til produkt: vi tegner, printer, justerer og printer på nytt til delen gjør jobben.',
    send: 'Problemet, målene og bilder av der delen skal brukes.',
  },
  {
    navn: 'Grafisk design',
    tekst:
      'Logo, skilt og grafikk tegnet slik at det faktisk kan produseres, i riktig format for print og 3D.',
    send: 'Det dere har av logo, farger og tekst.',
  },
  {
    navn: 'Profilering',
    tekst: 'Logoen i 3D, skilt til kontoret og ting med navnet på som dere kan gi bort eller bruke selv.',
    send: 'Logo som vektorfil (SVG eller PDF) hvis dere har den, og antall.',
  },
  {
    navn: 'Idépartner',
    tekst:
      'Har dere et behov, men ikke en løsning? Vi tenker høyt sammen med dere og foreslår hva som kan lages.',
    send: 'Noen setninger om hva som skal løses.',
  },
];
---

<Side
  tittel="For bedrifter"
  beskrivelse="Designporten er en idé- og produksjonspartner for bedrifter: prototyper, småserier, produktutvikling, grafisk design og profilering med 3D-print."
>
  <SideHode
    eyebrow="For bedrifter"
    tittel="En partner for ideer og produksjon, ikke et trykkeri"
    ingress="Prototyper, småserier, profilering og deler som ikke finnes. Vi tegner, printer og følger opp, fra første skisse til ferdig serie."
  />

  <div class="ramme bedrift__bilde">
    <Konseptbilde bilde={bakgrunner.samarbeid} lasting="eager" sizes="(max-width: 1280px) 100vw, 1280px" />
  </div>

  <section class="ramme seksjon" aria-labelledby="tjenester-tittel">
    <h2 id="tjenester-tittel" class="tjenester__tittel">
      Det vi gjør for bedrifter
    </h2>
    <ol class="tjenester">
      {tjenester.map((t, i) => (
        <li class="tjeneste avslor" style={`--i:${i % 3}`}>
          <p class="mono tjeneste__nr">{String(i + 1).padStart(2, '0')}</p>
          <h3>{t.navn}</h3>
          <p class="tjeneste__tekst">{t.tekst}</p>
          <p class="tjeneste__send">
            <span class="mono">Send oss</span>
            {t.send}
          </p>
        </li>
      ))}
    </ol>
  </section>

  <section class="skjemaseksjon" aria-labelledby="skjema-tittel">
    <div class="ramme skjemaseksjon__rutenett">
      <div class="skjemaseksjon__intro">
        <h2 id="skjema-tittel">Fortell oss hva dere trenger</h2>
        <p class="ingress">
          En setning holder for å begynne. Legg ved det dere har av skisser, filer og mål.
        </p>
        {(kontakt.epost || kontakt.telefon) && (
          <p class="skjemaseksjon__direkte">
            Direkte:
            {kontakt.epost && <a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a>}
            {kontakt.telefon && <span>{kontakt.telefon}</span>}
          </p>
        )}
      </div>
      <IdeSkjema id="skjema" kundetype="bedrift" />
    </div>
  </section>
</Side>

<style>
  .bedrift__bilde {
    aspect-ratio: 21 / 8;
    overflow: hidden;
    background: var(--kalk);
  }

  .bedrift__bilde :global(.konseptbilde),
  .bedrift__bilde :global(img) {
    height: 100%;
    object-fit: cover;
  }

  .tjenester__tittel {
    margin-bottom: var(--r-6);
  }

  .tjenester {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--kant);
  }

  .tjeneste {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--r-3);
    padding: var(--r-5) var(--r-5) var(--r-6) 0;
    border-bottom: 1px solid var(--kant);
  }

  .tjeneste:not(:nth-child(3n + 1)) {
    padding-left: var(--r-5);
    border-left: 1px solid var(--kant);
  }

  .tjeneste__nr {
    color: var(--dempet);
  }

  .tjeneste__tekst {
    color: var(--dempet);
  }

  .tjeneste__send {
    display: grid;
    gap: var(--r-1);
    padding-top: var(--r-3);
    border-top: 1px dashed var(--kant);
    font-size: var(--fs-liten);
  }

  .tjeneste__send .mono {
    color: var(--dempet);
    font-size: var(--fs-mono-liten);
  }

  @media (max-width: 900px) {
    .bedrift__bilde {
      aspect-ratio: 4 / 3;
    }

    .tjenester {
      grid-template-columns: 1fr 1fr;
    }

    .tjeneste:not(:nth-child(3n + 1)) {
      padding-left: 0;
      border-left: 0;
    }

    .tjeneste:nth-child(even) {
      padding-left: var(--r-5);
      border-left: 1px solid var(--kant);
    }
  }

  @media (max-width: 560px) {
    .tjenester {
      grid-template-columns: 1fr;
    }

    .tjeneste:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }

  .skjemaseksjon {
    padding-block: var(--r-8) var(--r-seksjon);
    background: var(--kalk);
  }

  .skjemaseksjon__rutenett {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--r-7);
    align-items: start;
  }

  .skjemaseksjon__intro {
    display: grid;
    gap: var(--r-4);
  }

  .skjemaseksjon__direkte {
    display: flex;
    flex-wrap: wrap;
    gap: var(--r-3);
  }

  @media (max-width: 900px) {
    .skjemaseksjon__rutenett {
      grid-template-columns: 1fr;
      gap: var(--r-5);
    }
  }
</style>
