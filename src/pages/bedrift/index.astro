---
import Side from '@/layouts/Side.astro';
import BildeHelt from '@/components/showroom/BildeHelt.astro';
import Knapp from '@/components/Knapp.astro';
import { kontakt } from '@/lib/kontakt';
import { bakgrunner } from '@/lib/ressurser';

/*
 * Services from the brief (information-architecture.md#for-bedrifter).
 * Each service will show a real Inspirasjon case when one exists; none is
 * confirmed yet, so no examples are shown. 3D scanning, office signs via CSV
 * batch and other capabilities stay out until confirmed or built.
 */
const tjenester = [
  {
    navn: 'Prototyper',
    tekst:
      'En fysisk versjon av produktet før dere bestemmer dere. Holde i, måle, teste passform og vise fram.',
    send: 'Skisse, tegning eller 3D-fil, og hva prototypen skal svare på.',
  },
  {
    navn: 'Småserier',
    tekst: 'Små opplag uten verktøy- og formkostnader. Samme fil gir samme del hver gang.',
    send: 'Filen eller en godkjent prototype, antall og materiale.',
  },
  {
    navn: 'Produktutvikling',
    tekst: 'Fra problem til produkt: vi tegner, printer, justerer og printer på nytt til delen gjør jobben.',
    send: 'Problemet, målene og bilder av der delen skal brukes.',
  },
  {
    navn: 'Grafisk design',
    tekst:
      'Logo, skilt og grafikk tegnet slik at det faktisk kan produseres, i riktig format for print og 3D.',
    send: 'Det dere har av logo, farger og tekst.',
  },
  {
    navn: 'Profilering',
    tekst: 'Logoen i 3D, skilt til kontoret og ting med navnet på som dere kan gi bort eller bruke selv.',
    send: 'Logo som vektorfil (SVG eller PDF) hvis dere har den, og antall.',
  },
  {
    navn: 'Idépartner',
    tekst:
      'Har dere et behov, men ikke en løsning? Vi tenker høyt sammen med dere og foreslår hva som kan lages.',
    send: 'Noen setninger om hva som skal løses.',
  },
];
---

<Side
  tittel="For bedrifter"
  beskrivelse="Designporten er en partner for prototype og produksjon: prototyper, småserier, produktutvikling, grafisk design og profilering med 3D-print."
>
  <link slot="hode" rel="preload" as="image" href={bakgrunner.verksted.src} fetchpriority="high" />
  <BildeHelt
    bilde={bakgrunner.verksted}
    etikett="For bedrifter"
    tittel="En partner for prototype og produksjon"
    ingress="Prototyper, småserier, profilering og deler som ikke finnes. Vi tegner, printer og følger opp, fra første skisse til ferdig serie."
    fokus="62% 45%"
  >
    <Knapp href="/foresporsel/?kundetype=bedrift" data-apne-foresporsel data-kundetype="bedrift">
      Fortell oss hva dere trenger
    </Knapp>
  </BildeHelt>

  <section class="ramme seksjon" aria-labelledby="tjenester-tittel">
    <p class="etikett">Tjenester</p>
    <h2 id="tjenester-tittel" class="tjenester__tittel">
      Det vi gjør for bedrifter
    </h2>
    <ul class="tjenester" role="list">
      {tjenester.map((t) => (
        <li class="tjeneste">
          <h3 class="tjeneste__navn">{t.navn}</h3>
          <p class="tjeneste__tekst">{t.tekst}</p>
          <p class="tjeneste__send">
            <span class="etikett">Send oss</span>
            {t.send}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="avslutning" aria-labelledby="avslutning-tittel">
    <div class="ramme avslutning__innhold">
      <div>
        <h2 id="avslutning-tittel">Fortell oss hva dere trenger</h2>
        <p class="avslutning__tekst">
          En setning holder for å begynne. Legg ved det dere har av skisser, filer og mål.
        </p>
        {(kontakt.epost || kontakt.telefon) && (
          <p class="avslutning__direkte">
            Direkte:
            {kontakt.epost && <a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a>}
            {kontakt.telefon && <span>{kontakt.telefon}</span>}
          </p>
        )}
      </div>
      <Knapp href="/foresporsel/?kundetype=bedrift" data-apne-foresporsel data-kundetype="bedrift">
        Start forespørselen
      </Knapp>
    </div>
  </section>
</Side>

<style>
  .tjenester__tittel {
    margin: var(--r-2) 0 var(--r-6);
  }

  .tjenester {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--r-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tjeneste {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--r-3);
    padding: var(--r-5);
    border: 1px solid var(--kant);
    border-radius: var(--radius-kort);
    background: var(--flate);
  }

  .tjeneste__navn {
    font-size: var(--fs-h3);
  }

  .tjeneste__tekst {
    color: var(--dempet);
  }

  .tjeneste__send {
    display: grid;
    gap: var(--r-1);
    padding-top: var(--r-3);
    border-top: 1px solid var(--kant);
    font-size: var(--fs-liten);
  }

  @media (max-width: 900px) {
    .tjenester {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tjenester {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .avslutning {
    padding-block: var(--r-8);
    background: var(--kalk);
  }

  .avslutning__innhold {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--r-5);
  }

  .avslutning__tekst {
    margin-top: var(--r-2);
    color: var(--dempet);
  }

  .avslutning__direkte {
    display: flex;
    flex-wrap: wrap;
    gap: var(--r-3);
    margin-top: var(--r-3);
  }
</style>
