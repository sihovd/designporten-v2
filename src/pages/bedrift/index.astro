---
import { nettsti } from '@/lib/nettsti';
import Side from '@/layouts/Side.astro';
import BildeHelt from '@/components/showroom/BildeHelt.astro';
import Knapp from '@/components/Knapp.astro';
import { kontakt } from '@/lib/kontakt';
import { bakgrunner } from '@/lib/ressurser';
import { sidetekst } from '@/lib/sidetekster';

/*
 * Services from the brief (information-architecture.md#for-bedrifter).
 * Each service will show a real Inspirasjon case when one exists; none is
 * confirmed yet, so no examples are shown. 3D scanning, office signs via CSV
 * batch and other capabilities stay out until confirmed or built. The words
 * live in src/content/sider/bedrift.json.
 */
const t = sidetekst('bedrift');
const tjenester = Array.from({ length: t.antall('tjenester.liste') }, (_, i) => `tjenester.liste.${i}`);
---

<Side tittel={t('meta.tittel')} beskrivelse={t('meta.beskrivelse')}>
  <link slot="hode" rel="preload" as="image" href={bakgrunner.verksted.src} fetchpriority="high" />
  <BildeHelt
    bilde={bakgrunner.verksted}
    etikett={t('helt.etikett')}
    tittel={t('helt.tittel')}
    ingress={t('helt.ingress')}
    kilde={t.kilde('helt')}
    fokus="62% 45%"
  >
    <Knapp href={nettsti('/foresporsel/?kundetype=bedrift')} data-apne-foresporsel data-kundetype="bedrift">
      <span {...t.r('helt.knapp1')}>{t('helt.knapp1')}</span>
    </Knapp>
  </BildeHelt>

  <section class="ramme seksjon" aria-labelledby="tjenester-tittel">
    <p class="etikett" {...t.r('tjenester.etikett')}>
      {t('tjenester.etikett')}
    </p>
    <h2 id="tjenester-tittel" class="tjenester__tittel" {...t.r('tjenester.tittel')}>
      {t('tjenester.tittel')}
    </h2>
    <ul class="tjenester" role="list">
      {tjenester.map((j) => (
        <li class="tjeneste">
          <h3 class="tjeneste__navn" {...t.r(`${j}.navn`)}>
            {t(`${j}.navn`)}
          </h3>
          <p class="tjeneste__tekst" {...t.r(`${j}.tekst`)}>
            {t(`${j}.tekst`)}
          </p>
          <p class="tjeneste__send">
            <span class="etikett" {...t.r('tjenester.sendEtikett')}>
              {t('tjenester.sendEtikett')}
            </span>
            <span {...t.r(`${j}.send`)}>{t(`${j}.send`)}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="avslutning" aria-labelledby="avslutning-tittel">
    <div class="ramme avslutning__innhold">
      <div>
        <h2 id="avslutning-tittel" {...t.r('avslutning.tittel')}>
          {t('avslutning.tittel')}
        </h2>
        <p class="avslutning__tekst" {...t.r('avslutning.tekst')}>
          {t('avslutning.tekst')}
        </p>
        {(kontakt.epost || kontakt.telefon) && (
          <p class="avslutning__direkte">
            Direkte:
            {kontakt.epost && <a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a>}
            {kontakt.telefon && <span>{kontakt.telefon}</span>}
          </p>
        )}
      </div>
      <Knapp href={nettsti('/foresporsel/?kundetype=bedrift')} data-apne-foresporsel data-kundetype="bedrift">
        <span {...t.r('avslutning.knapp')}>{t('avslutning.knapp')}</span>
      </Knapp>
    </div>
  </section>
</Side>

<style>
  .tjenester__tittel {
    margin: var(--r-2) 0 var(--r-6);
  }

  .tjenester {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--r-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tjeneste {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--r-3);
    padding: var(--r-5);
    border: 1px solid var(--kant);
    border-radius: var(--radius-kort);
    background: var(--flate);
  }

  .tjeneste__navn {
    font-size: var(--fs-h3);
  }

  .tjeneste__tekst {
    color: var(--dempet);
  }

  .tjeneste__send {
    display: grid;
    gap: var(--r-1);
    padding-top: var(--r-3);
    border-top: 1px solid var(--kant);
    font-size: var(--fs-liten);
  }

  @media (max-width: 900px) {
    .tjenester {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tjenester {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .avslutning {
    padding-block: var(--r-8);
    background: var(--kalk);
  }

  .avslutning__innhold {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--r-5);
  }

  .avslutning__tekst {
    margin-top: var(--r-2);
    color: var(--dempet);
  }

  .avslutning__direkte {
    display: flex;
    flex-wrap: wrap;
    gap: var(--r-3);
    margin-top: var(--r-3);
  }
</style>
