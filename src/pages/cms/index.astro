---
/**
 * The CMS (docs/cms/README.md): page texts with draft, publish and history,
 * agent proposals, users, log and backup. The API runs on the PHP build
 * (php/api/cms/); other builds show a short notice.
 */
import CmsPanel from '@/components/cms/CmsPanel';
import { nettsti } from '@/lib/nettsti';
import '@/styles/base.css';
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Designporten Studio – administrasjon</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={nettsti('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f6f5fa" />
  </head>
  <body class="studio-side">
    <a class="hopp-til-innhold" href="#innhold">
      Hopp til innholdet
    </a>
    <main id="innhold" tabindex="-1">
      <CmsPanel client:load />
    </main>
    <noscript>
      <p>
        CMS-et trenger JavaScript. <a href={nettsti('/')}>Til nettstedet</a>.
      </p>
    </noscript>
  </body>
</html>
