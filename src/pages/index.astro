---
import Side from '@/layouts/Side.astro';
import Helt from '@/components/showroom/hjem/Helt.astro';
import TreDorer from '@/components/showroom/hjem/TreDorer.astro';
import ProsessSlider from '@/components/showroom/ProsessSlider.astro';
import TopSlider from '@/components/showroom/TopSlider.astro';
import IdeBand from '@/components/showroom/IdeBand.astro';
import Bevis from '@/components/showroom/hjem/Bevis.astro';
import UtvalgteProdukter from '@/components/showroom/hjem/UtvalgteProdukter.astro';
import VerkstedPortal from '@/components/showroom/hjem/VerkstedPortal.astro';
import { hjemmeprosess } from '@/components/showroom/data/prosess';
import { bakgrunner, utklippbilder } from '@/lib/ressurser';
---

<Side
  tittel="Designporten"
  beskrivelse="Designporten er et norsk verksted for 3D-print, spesialdesign og personlige produkter. Finn noe ferdig, lag noe selv i Skaperverksted, eller fortell oss ideen din."
>
  <link slot="hode" rel="preload" as="image" href={utklippbilder.spiralvase.src} fetchpriority="high" />
  <Helt />
  <TreDorer />
  <ProsessSlider id="prosess" tittel="Slik blir en idé til en del" steg={hjemmeprosess} />
  <UtvalgteProdukter />
  <TopSlider
    id="fra-verkstedet"
    etikett="Fra verkstedet"
    lysbilder={[
      {
        kategori: '3D-design og print · Norge',
        tittel: 'Ferdige print, eller noe som ikke finnes ennå',
        tekst:
          'Vi tegner, printer og sender. Velg noe fra produktene, eller fortell oss ideen din og få den produsert i et materiale som tåler bruken.',
        bakgrunn: bakgrunner.samarbeid,
        objekt: utklippbilder.lampeskjerm,
        handlinger: [
          { tekst: 'Se produktene', href: '/produkter/' },
          { tekst: 'Fortell oss ideen din', href: '/spesialdesign/#skjema', variant: 'sekundar' },
        ],
      },
      {
        kategori: 'Spesialdesign',
        tittel: 'Delen du leter etter finnes kanskje ikke ennå',
        tekst:
          'Braketten som passer akkurat din hylle, eller reservedelen produsenten sluttet å lage. Send oss et mål eller en skisse, så sier vi fra hva som lar seg printe.',
        bakgrunn: bakgrunner.verksted,
        objekt: utklippbilder.kabelholder,
        handlinger: [{ tekst: 'Send en forespørsel', href: '/spesialdesign/?start=del#skjema' }],
      },
      {
        kategori: 'Materialvalg',
        tittel: 'Materialet avgjør om delen holder',
        tekst: 'PLA til det som skal stå pent innendørs. PETG til det som skal tåle sol, vann og bruk.',
        bakgrunn: bakgrunner.samarbeid,
        objekt: utklippbilder.fasettpotte,
        handlinger: [{ tekst: 'Spør oss om materialet', href: '/kontakt/', variant: 'sekundar' }],
      },
    ]}
  />
  <Bevis />
  <VerkstedPortal />
  <IdeBand />
</Side>
