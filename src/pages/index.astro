---
import { nettsti } from '@/lib/nettsti';
import Side from '@/layouts/Side.astro';
import BildeHelt from '@/components/showroom/BildeHelt.astro';
import Knapp from '@/components/Knapp.astro';
import Populaere from '@/components/showroom/hjem/Populaere.astro';
import Snarveier from '@/components/showroom/hjem/Snarveier.astro';
import ProsessSlider from '@/components/showroom/ProsessSlider.astro';
import Bevis from '@/components/showroom/hjem/Bevis.astro';
import VerkstedPortal from '@/components/showroom/hjem/VerkstedPortal.astro';
import NyligLaget from '@/components/showroom/hjem/NyligLaget.astro';
import { hjemmeprosess } from '@/components/showroom/data/prosess';
import { bakgrunner } from '@/lib/ressurser';
import { sidetekst } from '@/lib/sidetekster';

const t = sidetekst('forside');
---

<Side tittel={t('meta.tittel')} beskrivelse={t('meta.beskrivelse')}>
  <link
    slot="hode"
    rel="preload"
    as="image"
    href={bakgrunner.verksted.src}
    fetchpriority="high"
    data-rediger-bilde-forhand={t.kilde('helt.bilde')}
  />
  <BildeHelt
    bilde={bakgrunner.verksted}
    etikett={t('helt.etikett')}
    tittel={t('helt.tittel')}
    ingress={t('helt.ingress')}
    kilde={t.kilde('helt')}
    stor
    fokus="72% 45%"
  >
    <Knapp href={nettsti('/skaperverksted/')}>
      <span {...t.r('helt.knapp1')}>{t('helt.knapp1')}</span>
    </Knapp>
    <Knapp href={nettsti('/foresporsel/')} variant="sekundar" data-apne-foresporsel>
      <span {...t.r('helt.knapp2')}>{t('helt.knapp2')}</span>
    </Knapp>
  </BildeHelt>
  <Populaere />
  <Snarveier />
  <ProsessSlider
    id="prosess"
    etikett={t('prosess.etikett')}
    tittel={t('prosess.tittel')}
    kilde={t.kilde('prosess')}
    steg={hjemmeprosess}
  />
  <Bevis />
  <NyligLaget />
  <VerkstedPortal />
</Side>
