---
import Side from '@/layouts/Side.astro';
import SideHode from '@/components/showroom/SideHode.astro';
import Foresporsel from '@/components/showroom/skjema/Foresporsel.astro';
import { kontakt } from '@/lib/kontakt';
import { sidetekst } from '@/lib/sidetekster';

// Contact details, opening hours and FAQ appear only when Sivert confirms them (src/lib/kontakt.ts).
const t = sidetekst('kontakt');
const harDetaljer = Boolean(kontakt.epost || kontakt.telefon || kontakt.apningstider);
---

<Side tittel={t('meta.tittel')} beskrivelse={t('meta.beskrivelse')}>
  <SideHode
    eyebrow={t('helt.etikett')}
    tittel={t('helt.tittel')}
    ingress={t('helt.ingress')}
    kilde={t.kilde('helt')}
  />

  <section class="ramme kontakt" aria-label="Kontaktskjema og kontaktinformasjon">
    <div class="kontakt__skjema">
      <Foresporsel id="skjema" variant="kort" />
    </div>
    <aside class="kontakt__side" aria-label="Andre måter">
      <div class="kontakt__boks">
        <p class="etikett" {...t.r('skjema.etikett')}>
          {t('skjema.etikett')}
        </p>
        <p {...t.r('skjema.tekst')}>{t('skjema.tekst')}</p>
        <a href="/foresporsel/" data-apne-foresporsel>
          <span {...t.r('skjema.lenke')}>{t('skjema.lenke')}</span>
        </a>
      </div>
      {harDetaljer && (
        <div class="kontakt__boks">
          <p class="etikett">Direkte</p>
          {kontakt.epost && (
            <p>
              <a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a>
            </p>
          )}
          {kontakt.telefon && <p>{kontakt.telefon}</p>}
          {kontakt.apningstider && <p>{kontakt.apningstider}</p>}
        </div>
      )}
    </aside>
  </section>
</Side>

<style>
  .kontakt {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--r-7);
    align-items: start;
    padding-bottom: var(--r-seksjon);
  }

  .kontakt__side {
    display: grid;
    gap: var(--r-4);
  }

  .kontakt__boks {
    display: grid;
    gap: var(--r-2);
    padding: var(--r-5);
    border: 1px solid var(--kant);
    border-radius: var(--radius-kort);
    background: var(--flate);
  }

  @media (max-width: 860px) {
    .kontakt {
      grid-template-columns: 1fr;
    }
  }
</style>
