---
import Side from '@/layouts/Side.astro';
import SideHode from '@/components/showroom/SideHode.astro';
import IdeSkjema from '@/components/showroom/skjema/IdeSkjema.astro';
import { kontakt } from '@/lib/kontakt';

// Contact details, opening hours and FAQ appear only when Sivert confirms them (src/lib/kontakt.ts).
const harDetaljer = Boolean(kontakt.epost || kontakt.telefon || kontakt.apningstider);
---

<Side
  tittel="Kontakt"
  beskrivelse="Kontakt Designporten. Skriv hva det gjelder, så svarer vi på e-post. Har du en idé du vil ha laget, bruk idéskjemaet."
>
  <SideHode eyebrow="Kontakt" tittel="Skriv hva det gjelder" ingress="Vi svarer på e-post." />

  <section class="ramme kontakt" aria-label="Kontaktskjema og kontaktinformasjon">
    <div class="kontakt__skjema">
      <IdeSkjema id="skjema" variant="kort" />
    </div>
    <aside class="kontakt__side" aria-label="Andre måter">
      <div class="kontakt__boks">
        <p class="mono kontakt__etikett">Har du en idé?</p>
        <p>Vil du ha noe laget, gir idéskjemaet oss det vi trenger: bilder, mål og filer.</p>
        <a href="/spesialdesign/#skjema">Gå til idéskjemaet</a>
      </div>
      {harDetaljer && (
        <div class="kontakt__boks">
          <p class="mono kontakt__etikett">Direkte</p>
          {kontakt.epost && (
            <p>
              <a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a>
            </p>
          )}
          {kontakt.telefon && <p>{kontakt.telefon}</p>}
          {kontakt.apningstider && <p>{kontakt.apningstider}</p>}
        </div>
      )}
    </aside>
  </section>
</Side>

<style>
  .kontakt {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--r-7);
    align-items: start;
    padding-bottom: var(--r-seksjon);
  }

  .kontakt__side {
    display: grid;
    gap: var(--r-4);
  }

  .kontakt__boks {
    display: grid;
    gap: var(--r-2);
    padding: var(--r-5);
    border: 1px solid var(--kant);
    background: var(--flate);
  }

  .kontakt__etikett {
    color: var(--dempet);
  }

  @media (max-width: 860px) {
    .kontakt {
      grid-template-columns: 1fr;
    }
  }
</style>
