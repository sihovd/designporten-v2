---
import Side from '@/layouts/Side.astro';
import KontoSide from '@/components/konto/KontoSide';
---

<Side
  tittel="Min konto"
  beskrivelse="Logg inn eller lag en konto hos Designporten. Se planen din og skiltene du har delt fra Sign Forge."
>
  <header class="ramme konto-intro">
    <p class="etikett">Ditt kreative rom</p>
    <h1>Min konto</h1>
    <p>Her finner du tjenestene dine, prosjektene dine og profilen din. Alt samlet på ett sted.</p>
  </header>
  <section class="ramme seksjon konto-side">
    <KontoSide client:load />
  </section>
</Side>

<style>
  .konto-side {
    padding-top: var(--r-5);
  }
  .konto-intro {
    display: grid;
    gap: var(--r-3);
    padding-top: clamp(32px, 5vw, 72px);
    padding-bottom: var(--r-4);
  }
  .konto-intro h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .konto-intro > p:last-child {
    max-width: 58ch;
    color: var(--fg-dempet);
    font-size: 1.125rem;
  }
</style>
