---
import Side from '@/layouts/Side.astro';
import SideHode from '@/components/showroom/SideHode.astro';
import VaseBygg from '@/components/showroom/bygg/VaseBygg.astro';
import Knapp from '@/components/Knapp.astro';

/*
 * The story text is the test bench draft kept by the spec
 * (information-architecture.md#om-designporten). Facts (years, printers,
 * materials, delivered projects) and photos of the real workshop are added
 * only when confirmed; until then no fact tiles and no people are shown.
 */
const lager = [
  '3D-print av ferdige produkter',
  'Spesialdesign fra idé, skisse, bilde eller ødelagt del',
  'Personlige produkter med navn og tekst',
  'Prototyper og småserier',
  'Grafisk design og profilering',
  'Skaperverksted: verktøy der du designer selv',
];
---

<Side
  tittel="Om Designporten"
  beskrivelse="Designporten er et lite norsk verksted som både tegner og produserer: 3D-print, spesialdesign, personlige produkter og digitale verktøy."
>
  <SideHode eyebrow="Om" tittel="Et verksted som både tegner og produserer" />

  <section class="ramme om" aria-label="Historien">
    <div class="om__tekst">
      <p class="om__stor">
        Designporten er et lite verksted som både tegner og produserer. Vi startet fordi altfor mye 3D-print
        stopper på halvveien: en fil finnes, men ingen tar ansvar for at delen faktisk passer, holder og ser
        ut som noe man vil ha stående framme.
      </p>
      <p>
        Derfor gjør vi begge deler. Du kan finne noe ferdig blant produktene, designe noe selv i
        Skaperverksted, eller la oss tegne noe fra bunnen. I alle tilfeller er det samme verksted som printer
        det.
      </p>
    </div>
    <figure class="om__figur">
      <VaseBygg tilstand="mesh" />
      <figcaption class="mono">Kontur og modell av vasen fra forsiden, slik den tegnes før print.</figcaption>
    </figure>
  </section>

  <section class="ramme seksjon" aria-labelledby="lager-tittel">
    <h2 id="lager-tittel">Det verkstedet lager</h2>
    <ul class="lager">
      {lager.map((l) => (
        <li>{l}</li>
      ))}
    </ul>
  </section>

  <section class="ramme seksjon om__videre" aria-labelledby="videre-tittel">
    <h2 id="videre-tittel">Vil du se verkstedet i arbeid?</h2>
    <p class="ingress">
      Bilder av verkstedet og maskinene kommer. Til da kan du se hvordan en idé blir til en del.
    </p>
    <div class="om__handlinger">
      <Knapp href="/spesialdesign/#skjema">Fortell oss ideen din</Knapp>
      <Knapp href="/kontakt/" variant="sekundar">
        Kontakt oss
      </Knapp>
    </div>
  </section>
</Side>

<style>
  .om {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--r-7);
    align-items: center;
  }

  .om__tekst {
    display: grid;
    gap: var(--r-5);
    max-width: 60ch;
  }

  .om__stor {
    font-size: var(--fs-ingress);
    line-height: 1.5;
  }

  .om__figur {
    margin: 0;
    display: grid;
    gap: var(--r-3);
    padding: var(--r-5);
    border: 1px solid var(--kant);
    background: var(--flate);
  }

  .om__figur figcaption {
    color: var(--dempet);
    text-transform: none;
    letter-spacing: 0;
  }

  .lager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin: var(--r-6) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--kant);
  }

  .lager li {
    padding: var(--r-4) var(--r-4) var(--r-4) 0;
    border-bottom: 1px solid var(--kant);
    font-size: 1.125rem;
    font-weight: 560;
  }

  .om__videre {
    display: grid;
    gap: var(--r-4);
    justify-items: start;
  }

  .om__handlinger {
    display: flex;
    flex-wrap: wrap;
    gap: var(--r-3);
    margin-top: var(--r-2);
  }

  @media (max-width: 860px) {
    .om {
      grid-template-columns: 1fr;
    }
  }
</style>
