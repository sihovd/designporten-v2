---
import { nettsti } from '@/lib/nettsti';
import Side from '@/layouts/Side.astro';
import Knapp from '@/components/Knapp.astro';
import Konseptbilde from '@/components/Konseptbilde.astro';
import { bakgrunner } from '@/lib/ressurser';
import { sidetekst } from '@/lib/sidetekster';

/*
 * Om, rewritten around skaperglede (design revision 2026-10-02, §22). The
 * story builds on Sivert's own words in the brief. Facts (years, printers,
 * delivered projects) and the profile photo are added only when confirmed;
 * until then the photo is a marked placeholder and no fact tiles are shown.
 * The words live in src/content/sider/om.json.
 */
const t = sidetekst('om');
const historie = Array.from({ length: t.antall('historie') }, (_, i) => `historie.${i}.tekst`);
const lager = Array.from({ length: t.antall('lager.punkter') }, (_, i) => `lager.punkter.${i}`);
---

<Side tittel={t('meta.tittel')} beskrivelse={t('meta.beskrivelse')}>
  <section class="ramme om-topp" aria-labelledby="om-tittel">
    <p class="etikett" {...t.r('topp.etikett')}>
      {t('topp.etikett')}
    </p>
    <h1 id="om-tittel" {...t.r('topp.tittel')}>
      {t('topp.tittel')}
    </h1>
    <p class="om-topp__ingress" {...t.r('topp.ingress')}>
      {t('topp.ingress')}
    </p>
  </section>

  <section class="ramme om-historie" aria-label="Historien">
    <div class="om-historie__tekst">
      {historie.map((sti, i) => (
        <p class:list={{ 'om-historie__stor': i === 0 }} {...t.r(sti)}>
          {t(sti)}
        </p>
      ))}
    </div>
    <figure class="om-historie__bilde">
      <Konseptbilde bilde={bakgrunner.samarbeid} sizes="(min-width: 900px) 40vw, 100vw" />
    </figure>
  </section>

  <section class="ramme om-profil" aria-labelledby="profil-tittel">
    <div class="om-profil__bilde" role="img" aria-label="Plassholder for profilbilde av Sivert">
      <span class="om-profil__merke mono">Plassholder</span>
      <span class="om-profil__tekst">Profilbilde kommer</span>
    </div>
    <div class="om-profil__innhold">
      <p class="etikett" {...t.r('profil.etikett')}>
        {t('profil.etikett')}
      </p>
      <h2 id="profil-tittel" {...t.r('profil.tittel')}>
        {t('profil.tittel')}
      </h2>
      <p {...t.r('profil.avsnitt1')}>{t('profil.avsnitt1')}</p>
      <p {...t.r('profil.avsnitt2')}>{t('profil.avsnitt2')}</p>
      <div class="om-profil__handlinger">
        <Knapp href={nettsti('/foresporsel/')} data-apne-foresporsel>
          <span {...t.r('profil.knapp1')}>{t('profil.knapp1')}</span>
        </Knapp>
        <Knapp href={nettsti('/kontakt/')} variant="sekundar">
          <span {...t.r('profil.knapp2')}>{t('profil.knapp2')}</span>
        </Knapp>
      </div>
    </div>
  </section>

  <section class="ramme seksjon" aria-labelledby="lager-tittel">
    <p class="etikett" {...t.r('lager.etikett')}>
      {t('lager.etikett')}
    </p>
    <h2 id="lager-tittel" class="lager__tittel" {...t.r('lager.tittel')}>
      {t('lager.tittel')}
    </h2>
    <ul class="lager" role="list">
      {lager.map((l) => (
        <li>
          <span class="lager__navn" {...t.r(`${l}.navn`)}>
            {t(`${l}.navn`)}
          </span>
          <span class="lager__tekst" {...t.r(`${l}.tekst`)}>
            {t(`${l}.tekst`)}
          </span>
        </li>
      ))}
    </ul>
  </section>
</Side>

<style>
  .om-topp {
    display: grid;
    gap: var(--r-3);
    padding-block: var(--r-8) var(--r-6);
  }

  .om-topp h1 {
    max-width: 18ch;
  }

  .om-topp__ingress {
    max-width: 52ch;
    color: var(--dempet);
    font-size: var(--fs-ingress);
  }

  .om-historie {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--r-7);
    align-items: start;
  }

  .om-historie__tekst {
    display: grid;
    gap: var(--r-4);
    max-width: 62ch;
  }

  .om-historie__stor {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--vekt-display);
    line-height: 1.45;
  }

  .om-historie__bilde {
    margin: 0;
    border-radius: var(--radius-kort);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .om-historie__bilde :global(.konseptbilde),
  .om-historie__bilde :global(img) {
    height: 100%;
    object-fit: cover;
  }

  .om-profil {
    display: grid;
    grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);
    gap: var(--r-7);
    align-items: center;
    margin-top: var(--r-8);
    padding-block: var(--r-7);
    border-block: 1px solid var(--kant);
  }

  .om-profil__bilde {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 1px dashed var(--kant-sterk);
    border-radius: 50%;
    background: var(--kalk);
  }

  .om-profil__merke {
    position: absolute;
    top: 12%;
    padding: 2px 8px;
    background: var(--blekk);
    color: #fff;
    font-size: var(--fs-mono-liten);
  }

  .om-profil__tekst {
    color: var(--dempet);
    font-size: var(--fs-liten);
  }

  .om-profil__innhold {
    display: grid;
    gap: var(--r-3);
    max-width: 58ch;
  }

  .om-profil__innhold h2 {
    margin-bottom: var(--r-2);
  }

  .om-profil__handlinger {
    display: flex;
    flex-wrap: wrap;
    gap: var(--r-3);
    margin-top: var(--r-3);
  }

  .lager__tittel {
    margin: var(--r-2) 0 var(--r-5);
  }

  .lager {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--r-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lager li {
    display: grid;
    gap: var(--r-1);
    padding-top: var(--r-3);
    border-top: 1px solid var(--kant);
  }

  .lager__navn {
    font-family: var(--font-display);
    font-weight: var(--vekt-h3);
  }

  .lager__tekst {
    color: var(--dempet);
    font-size: var(--fs-liten);
  }

  @media (max-width: 900px) {
    .om-historie,
    .om-profil {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--r-5);
    }

    .om-historie__bilde {
      aspect-ratio: 4 / 3;
    }

    .om-profil__bilde {
      width: min(220px, 60%);
    }

    .lager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .lager {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
