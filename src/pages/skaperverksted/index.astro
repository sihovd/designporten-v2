---
import { nettsti } from '@/lib/nettsti';
import Side from '@/layouts/Side.astro';
import VerktoyKort from '@/components/showroom/verksted/VerktoyKort.astro';
import { verktoy } from '@/components/showroom/verksted/verktoy';
import Knapp from '@/components/Knapp.astro';
import { skaperverkstedApent } from '@/lib/flagg';

const tilgjengelige = verktoy.filter((v) => v.status === 'tilgjengelig').length;

// «Slik fungerer det» (design revision 2026-10-02, §12).
const steg = [
  { navn: 'Bygg', tekst: 'Tekst, former og egne filer blir fysiske lag med høyde og farge.' },
  { navn: 'Se i 3D', tekst: 'Snu og zoom modellen mens du jobber, i ekte millimeter.' },
  { navn: 'Forhåndsvis print', tekst: 'Slå på printlag og se lagene slik printeren bygger dem.' },
  { navn: 'Last ned eller bestill', tekst: 'Ta filen med til din egen printer, eller send den til oss.' },
];
---

{!skaperverkstedApent ? (
  // The tools are closed in this build (src/lib/flagg.ts): a calm note, not indexed.
  <Side tittel="Skaperverksted" beskrivelse="Skaperverksted er ikke åpnet ennå." ikkeIndekser>
    <section class="hub verksted-flate" data-mork aria-labelledby="hub-tittel">
      <div class="hub-rutenett" aria-hidden="true"></div>
      <div class="hub-innhold">
        <div class="hub-topp">
          <p class="etikett hub-etikett">Skaperverksted</p>
          <h1 id="hub-tittel">Kommer snart</h1>
          <p class="hub-ingress">
            Her skal du kunne bygge skilt, former og figurer selv i nettleseren. Verktøyene er ikke åpnet
            ennå. Til da kan du fortelle oss hva du vil lage, så hjelper vi deg.
          </p>
          <div class="hub-handlinger">
            <Knapp href={nettsti('/foresporsel/')} data-apne-foresporsel>
              Fortell oss ideen din
            </Knapp>
            <Knapp href={nettsti('/produkter/')} variant="sekundar">
              Se utvalget
            </Knapp>
          </div>
        </div>
      </div>
    </section>
  </Side>
) : (
  <Side
    tittel="Skaperverksted"
    beskrivelse="Skaperverksted er Designportens verksted i nettleseren. Bygg skilt, former og figurer i ekte millimeter, se dem i 3D og last ned filen eller bestill utskrift."
  >
    <section class="hub verksted-flate" data-mork aria-labelledby="hub-tittel">
      <div class="hub-rutenett" aria-hidden="true"></div>
      <div class="hub-innhold">
        <div class="hub-topp">
          <p class="etikett hub-etikett">Skaperverksted · {tilgjengelige} verktøy · mål i mm</p>
          <h1 id="hub-tittel">Fra idé til ferdig fil</h1>
          <p class="hub-ingress">
            Her bygger du selv. Alt måles i ekte millimeter, du ser resultatet i 3D mens du jobber, og det du
            lager kan lastes ned som 3MF eller STL eller bestilles ferdig printet fra oss.
          </p>
        </div>

        <ul class="hub-liste" role="list">
          {verktoy.map((v) => (
            <li>
              <VerktoyKort verktoy={v} nivaa="h2" />
            </li>
          ))}
        </ul>
        <p class="hub-fotnote">
          Tegningene viser startmodellen i hvert verktøy, på et rutenett med ruter på 10 mm.
        </p>

        <section class="hub-bunn" aria-labelledby="slik-tittel">
          <h2 id="slik-tittel" class="hub-bunn__tittel">
            Slik fungerer det
          </h2>
          <ol class="hub-steg">
            {steg.map((s, i) => (
              <li>
                <span class="mono hub-nr">{String(i + 1).padStart(2, '0')}</span>
                <span class="hub-steg__navn">{s.navn}</span>
                <span class="hub-steg__tekst">{s.tekst}</span>
              </li>
            ))}
          </ol>
          <p class="hub-spes">
            Har du en idé som ikke passer i et verktøy?{' '}
            <a href={nettsti('/foresporsel/')} data-apne-foresporsel>
              Fortell oss om den
            </a>
            .
          </p>
        </section>
      </div>
    </section>
  </Side>
)}

<style>
  .hub {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-bottom: var(--r-seksjon);
  }

  .hub-rutenett {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--linje-mork) 1px, transparent 1px),
      linear-gradient(90deg, var(--linje-mork) 1px, transparent 1px);
    background-size: 80px 80px;
    background-position: 50% 0;
    mask-image: radial-gradient(ellipse 80% 55% at 50% 20%, #000 10%, transparent 80%);
    opacity: 0.5;
  }

  .hub-innhold {
    width: min(var(--innhold-maks), 100% - 2 * var(--gutter));
    margin-inline: auto;
  }

  .hub-topp {
    display: grid;
    gap: var(--r-4);
    padding: var(--r-8) 0 var(--r-6);
  }

  .hub-handlinger {
    display: flex;
    flex-wrap: wrap;
    gap: var(--r-3);
    padding-top: var(--r-2);
  }

  .hub-etikett {
    color: var(--dp-cyan);
  }

  .hub h1 {
    color: var(--fg);
    max-width: 16ch;
  }

  .hub-ingress {
    color: var(--fg-dempet);
    font-size: var(--fs-ingress);
    max-width: 58ch;
  }

  .hub-liste {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--r-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1100px) {
    .hub-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .hub-liste {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hub-fotnote {
    padding-top: var(--r-3);
    color: var(--dempet-mork);
    font-size: var(--fs-liten);
  }

  .hub-bunn {
    display: grid;
    gap: var(--r-5);
    padding-top: var(--r-8);
  }

  .hub-bunn__tittel {
    color: var(--fg);
    font-size: var(--fs-h2);
  }

  .hub-steg {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--r-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .hub-steg li {
    display: grid;
    gap: var(--r-1);
    align-content: start;
    padding-top: var(--r-3);
    border-top: 1px solid var(--linje);
  }

  .hub-nr {
    color: var(--dp-cyan);
    font-size: var(--fs-mono-liten);
  }

  .hub-steg__navn {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--fs-etikett);
    font-weight: 600;
    letter-spacing: var(--sporing-etikett);
    text-transform: uppercase;
  }

  .hub-steg__tekst {
    color: var(--fg-dempet);
    font-size: var(--fs-liten);
    max-width: 32ch;
  }

  .hub-spes {
    color: var(--fg-dempet);
  }

  .hub-spes a {
    color: var(--lenke);
  }

  @media (max-width: 900px) {
    .hub-steg {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .hub-steg {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
