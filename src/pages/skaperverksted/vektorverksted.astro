const til = nettsti('/skaperverksted/vectorium/');
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${til}`} />
    <link rel="canonical" href={til} />
    <title>Vectorium – Designporten</title>
  </head>
  <body>
    <p>
      Verktøyet heter nå Vectorium. <a href={til}>Gå til Vectorium</a>.
    </p>
  </body>
</html>
