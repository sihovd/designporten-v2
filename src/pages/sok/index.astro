---
import Side from '@/layouts/Side.astro';
import Ikon from '@/components/Ikon.astro';
---

<Side tittel="Søk" beskrivelse="Søk etter produkter, materialer, verktøy og inspirasjon hos Designporten.">
  <section class="ramme sok" aria-labelledby="sok-tittel">
    <p class="etikett">Søk</p>
    <h1 id="sok-tittel" class="sok__overskrift">
      Hva leter du etter?
    </h1>
    <form class="sok__skjema" role="search" action="/sok/" method="get" data-sokeskjema>
      <label for="sok-felt" class="visuelt-skjult">
        Søk
      </label>
      <input
        id="sok-felt"
        name="q"
        type="search"
        placeholder="Produkter, verktøy, guider …"
        autocomplete="off"
        data-sokefelt
      />
      <button type="submit" class="sok__knapp" aria-label="Søk">
        <Ikon navn="sok" />
      </button>
    </form>

    <p class="sok__status" role="status" aria-live="polite" data-sokestatus></p>
    <div class="sok__treff" data-soketreff></div>

    <noscript>
      <p class="sok__uten-js">
        Søket trenger JavaScript. Du finner alt via menyen: <a href="/produkter/">Vårt utvalg</a>,
        <a href="/skaperverksted/">Skaperverksted</a>, <a href="/spesialdesign/">Spesialdesign</a>,
        <a href="/inspirasjon/">Inspirasjon</a>.
      </p>
    </noscript>
  </section>
</Side>

<script>
  import { grupper, sok, type Sokepost } from '@/components/showroom/sok/sok';

  const skjema = document.querySelector<HTMLFormElement>('[data-sokeskjema]')!;
  const felt = document.querySelector<HTMLInputElement>('[data-sokefelt]')!;
  const status = document.querySelector<HTMLElement>('[data-sokestatus]')!;
  const liste = document.querySelector<HTMLElement>('[data-soketreff]')!;
  let poster: Sokepost[] | null = null;

  async function hent(): Promise<Sokepost[]> {
    if (!poster) poster = (await (await fetch('/sok.json')).json()) as Sokepost[];
    return poster;
  }

  let ur: number | undefined;
  async function vis(sporring: string) {
    const q = sporring.trim();
    if (!q) {
      liste.replaceChildren();
      status.textContent = '';
      return;
    }
    const treff = sok(await hent(), q);
    status.textContent = treff.length
      ? `${treff.length} treff for «${q}»`
      : `Ingen treff for «${q}». Prøv et annet ord, eller fortell oss hva du leter etter via idéskjemaet.`;
    liste.replaceChildren(
      ...grupper(treff).map((g) => {
        const seksjon = document.createElement('section');
        seksjon.className = 'sok__gruppe';
        const h = document.createElement('h2');
        h.className = 'sok__gruppetittel';
        h.textContent = `${g.navn} `;
        const n = document.createElement('span');
        n.className = 'sok__antall';
        n.textContent = String(g.treff.length);
        h.append(n);
        const ol = document.createElement('ol');
        ol.append(
          ...g.treff.map((t) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = t.url;
            const type = document.createElement('span');
            type.className = 'sok__type';
            type.textContent = t.type;
            const tittel = document.createElement('span');
            tittel.className = 'sok__tittel';
            tittel.textContent = t.tittel;
            a.append(tittel, type);
            li.append(a);
            if (t.tekst) {
              const p = document.createElement('p');
              p.textContent = t.tekst;
              li.append(p);
            }
            return li;
          }),
        );
        seksjon.append(h, ol);
        return seksjon;
      }),
    );
  }

  felt.addEventListener('input', () => {
    window.clearTimeout(ur);
    ur = window.setTimeout(() => {
      const url = new URL(window.location.href);
      if (felt.value.trim()) url.searchParams.set('q', felt.value.trim());
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
      void vis(felt.value);
    }, 160);
  });
  skjema.addEventListener('submit', (e) => {
    e.preventDefault();
    void vis(felt.value);
  });

  const start = new URLSearchParams(window.location.search).get('q');
  if (start) {
    felt.value = start;
    void vis(start);
  }
  felt.focus();
</script>

<style>
  .sok {
    padding-block: var(--r-8) var(--r-seksjon);
  }

  .sok__overskrift {
    margin: var(--r-2) 0 var(--r-5);
    font-size: var(--fs-h2);
  }

  .sok > * {
    max-width: 820px;
  }

  .sok__skjema {
    display: flex;
    border: 1px solid var(--kant-sterk);
    border-radius: var(--radius-pille);
    padding-left: var(--r-5);
    background: var(--flate);
  }

  .sok__skjema input {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 1.125rem;
  }

  .sok__skjema input:focus-visible {
    outline: none;
  }

  .sok__skjema:focus-within {
    border-color: var(--dp-lilla);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--dp-lilla) 20%, transparent);
  }

  .sok__skjema input::placeholder {
    color: var(--dempet);
  }

  .sok__knapp {
    width: 56px;
    border: 0;
    background: none;
  }

  .sok__status {
    margin-top: var(--r-4);
    color: var(--dempet);
  }

  .sok__treff {
    display: grid;
    gap: var(--r-6);
    margin-top: var(--r-5);
  }

  .sok__treff :global(.sok__gruppetittel) {
    display: flex;
    align-items: center;
    gap: var(--r-2);
    padding-bottom: var(--r-2);
    border-bottom: 1px solid var(--kant);
    font-family: var(--font-tekst);
    font-size: var(--fs-etikett);
    font-weight: 600;
    letter-spacing: var(--sporing-etikett);
    text-transform: uppercase;
    color: var(--dempet);
  }

  .sok__treff :global(.sok__antall) {
    min-width: 1.5rem;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--kalk);
    color: var(--blekk);
    letter-spacing: 0;
    text-align: center;
  }

  .sok__treff :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sok__treff :global(li) {
    display: grid;
    gap: 2px;
    padding: var(--r-3) 0;
    border-bottom: 1px solid var(--kant);
  }

  .sok__treff :global(a) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--r-1) var(--r-3);
    color: var(--blekk);
    text-decoration: none;
  }

  .sok__treff :global(a:hover .sok__tittel) {
    color: var(--lenke);
    text-decoration: underline;
  }

  .sok__treff :global(.sok__type) {
    color: var(--dempet);
    font-size: var(--fs-liten);
  }

  .sok__treff :global(.sok__tittel) {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: var(--vekt-h3);
  }

  .sok__treff :global(p) {
    color: var(--dempet);
    font-size: var(--fs-liten);
  }

  .sok__uten-js {
    margin-top: var(--r-4);
  }
</style>
