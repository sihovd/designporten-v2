---
import Side from '@/layouts/Side.astro';
import BildeHelt from '@/components/showroom/BildeHelt.astro';
import Ikon from '@/components/Ikon.astro';
import ProsessSlider from '@/components/showroom/ProsessSlider.astro';
import { spesialprosess } from '@/components/showroom/data/prosess';
import { bakgrunner } from '@/lib/ressurser';

const innganger = [
  {
    kundetype: 'privat',
    etikett: 'Privatkunde',
    tittel: 'Noe du vil ha laget',
    tekst:
      'En reservedel, en gave, en ting som mangler hjemme. Du trenger ikke ha en ferdig modell; en skisse, et bilde eller et par setninger holder.',
    knapp: 'Start som privatkunde',
  },
  {
    kundetype: 'bedrift',
    etikett: 'Bedriftskunde',
    tittel: 'Prototyper, småserier og profilering',
    tekst:
      'For bedrifter og organisasjoner. Fortell oss om prosjektet, antallet og kravene, så finner vi ut av resten sammen.',
    knapp: 'Start som bedrift',
  },
];
---

<Side
  tittel="Spesialdesign"
  beskrivelse="Har du tegningen, bildet eller bare ideen? Designporten hjelper deg å gjøre den fysisk: fra skisse, bilde, 3D-fil eller ødelagt del til ferdig 3D-printet produkt."
>
  <link slot="hode" rel="preload" as="image" href={bakgrunner.samarbeid.src} fetchpriority="high" />
  <BildeHelt
    bilde={bakgrunner.samarbeid}
    etikett="Spesialdesign"
    tittel="Har du tegningen, bildet eller bare ideen?"
    ingress="Vi hjelper deg å gjøre den fysisk. Du trenger ikke ha en ferdig modell. Start med ideen."
    fokus="68% 50%"
  />

  <section class="ramme innganger" aria-labelledby="innganger-tittel">
    <h2 id="innganger-tittel" class="innganger__tittel">
      Hvem er du?
    </h2>
    <ul class="innganger__liste" role="list">
      {innganger.map((g) => (
        <li class="inngang">
          <p class="etikett">{g.etikett}</p>
          <h3 class="inngang__tittel">{g.tittel}</h3>
          <p class="inngang__tekst">{g.tekst}</p>
          <a
            class="inngang__knapp"
            href={`/foresporsel/?kundetype=${g.kundetype}`}
            data-apne-foresporsel
            data-kundetype={g.kundetype}
          >
            {g.knapp} <Ikon navn="pil-hoyre" storrelse={18} />
          </a>
        </li>
      ))}
    </ul>
    <p class="innganger__merknad">
      Pris og tid avhenger av størrelse, materiale, antall og hvor mye som må tegnes. Derfor regner vi på hver
      forespørsel. Les mer <a href="/bedrift/">for bedrifter</a>.
    </p>
  </section>

  <ProsessSlider id="tjenesteflyt" tittel="Fra idé til ferdig produkt" steg={spesialprosess} takt={38} />
  <div class="slutt" aria-hidden="true"></div>
</Side>

<style>
  .innganger {
    display: grid;
    gap: var(--r-5);
    padding-block: var(--r-8) var(--r-4);
  }

  .innganger__tittel {
    font-size: var(--fs-h2);
  }

  .innganger__liste {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--r-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inngang {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--r-3);
    padding: var(--r-6);
    border: 1px solid var(--kant);
    border-radius: var(--radius-kort);
    background: var(--flate);
  }

  .inngang:last-child {
    background: var(--kalk);
  }

  .inngang__tittel {
    font-size: var(--fs-h3);
  }

  .inngang__tekst {
    max-width: 46ch;
    color: var(--dempet);
  }

  .inngang__knapp {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--r-2);
    min-height: var(--mal-beroring);
    margin-top: var(--r-2);
    padding-inline: 1.375rem;
    border-radius: var(--radius-pille);
    background: var(--blekk);
    color: var(--papir);
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--t-rask) ease;
  }

  .inngang__knapp:hover {
    transform: translateY(-1px);
  }

  .inngang__knapp :global(svg) {
    transition: transform var(--t-rask) ease;
  }

  .inngang__knapp:hover :global(svg) {
    transform: translateX(3px);
  }

  .innganger__merknad {
    max-width: 62ch;
    color: var(--dempet);
    font-size: var(--fs-liten);
  }

  .slutt {
    height: var(--r-seksjon);
  }

  @media (max-width: 760px) {
    .innganger__liste {
      grid-template-columns: minmax(0, 1fr);
    }

    .inngang {
      padding: var(--r-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inngang__knapp,
    .inngang__knapp :global(svg) {
      transition: none;
    }

    .inngang__knapp:hover,
    .inngang__knapp:hover :global(svg) {
      transform: none;
    }
  }
</style>
