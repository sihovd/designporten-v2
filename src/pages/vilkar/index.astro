---
import JuridiskSide from '@/components/showroom/JuridiskSide.astro';
import { kontakt, virksomhet } from '@/lib/kontakt';
---

<JuridiskSide tittel="Vilkår" beskrivelse="Kjøps- og bruksvilkår for Designporten.">
  <h2>Hvem du handler med</h2>
  <p>
    {virksomhet.navn}, org.nr. {virksomhet.organisasjonsnummerVisning}, {virksomhet.adresse},{' '}
    {virksomhet.poststed}.
  </p>
  <p>
    E-post: <a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a>.
  </p>
  <h2>Bestillinger</h2>
  <p>
    Nettstedet tar ikke imot betaling ennå. En bestilling fra handlekurven sendes til oss som en forespørsel,
    og vi avtaler pris, betaling og levering med deg før noe produseres.
  </p>

  <h2>Spesialdesign</h2>
  <p>Vilkår for spesialdesign, prototyper og småserier fylles inn når de er bekreftet.</p>

  <h2>Skaperverksted</h2>
  <p>Vilkår for bruk av Skaperverksted og filene du lager der, fylles inn når de er bestemt.</p>

  <h2>Angrerett, reklamasjon og selger</h2>
  <p>Angrerett, reklamasjon og opplysninger om selger fylles inn når de er bekreftet.</p>
</JuridiskSide>
